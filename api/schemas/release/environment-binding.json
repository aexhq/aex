{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aex.dev/release/v1/environment-binding.json",
  "title": "aex.environment-binding.v1",
  "description": "The public shape of a private environment binding. The private repository supplies the values; this schema is what makes them reviewable. The containing source commit is external provenance and is deliberately not sealed into this content-addressed document. Plaintext secrets are structurally impossible: every secret field is a reference type, so a binding carrying a credential is invalid rather than merely discouraged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bindingDigest",
    "plane",
    "regions",
    "desiredReleaseId",
    "rootModuleVersion",
    "infraModuleBundleDigest",
    "resources",
    "secrets",
    "config",
    "approval"
  ],
  "properties": {
    "schema": { "const": "aex.environment-binding.v1" },
    "bindingDigest": {
      "description": "sha256 over RFC 8785 canonical bytes with bindingDigest removed.",
      "$ref": "#/$defs/sha256"
    },
    "plane": { "enum": ["dev", "prd"] },
    "regions": {
      "description": "Unique AWS regions in ascending lexical order.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" }
    },
    "desiredReleaseId": { "$ref": "#/$defs/sha256" },
    "rootModuleVersion": { "type": "string" },
    "infraModuleBundleDigest": { "$ref": "#/$defs/sha256" },
    "resources": {
      "description": "Logical name to physical resource. Logical names are the public vocabulary: session_journal, content_bucket, brain_image, usage_rating_queue, central_cluster, regional_authz_projection.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{2,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "accountId", "region"],
        "properties": {
          "kind": { "type": "string" },
          "accountId": { "type": "string", "pattern": "^[0-9]{12}$" },
          "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" },
          "arn": { "type": "string", "pattern": "^arn:aws[a-z-]*:" },
          "url": {
            "description": "HTTPS endpoint without userinfo, query or fragment.",
            "type": "string",
            "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
          },
          "immutableVersion": { "type": "string" }
        }
      }
    },
    "secrets": {
      "description": "Reference only. There is no field a secret value can occupy.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{2,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arn", "versionId", "kind"],
        "properties": {
          "arn": { "type": "string", "pattern": "^arn:aws[a-z-]*:secretsmanager:" },
          "versionId": { "type": "string" },
          "versionStage": { "type": "string" },
          "kind": {
            "enum": [
              "api-key",
              "signing-key",
              "webhook-secret",
              "database-credential",
              "token-pepper",
              "project-token"
            ]
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleDigest", "schemaVersions"],
      "properties": {
        "bundleDigest": { "$ref": "#/$defs/sha256" },
        "schemaVersions": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vercel": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["teamId", "projectId"],
            "properties": {
              "teamId": { "type": "string" },
              "projectId": { "type": "string" }
            }
          }
        }
      }
    },
    "dataVersions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priceBookRevision": { "type": "string" },
        "taxTableRevision": { "type": "string" },
        "riskThresholdRevision": { "type": "string" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "approvers"],
      "properties": {
        "policy": { "type": "string" },
        "approvers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "maintenanceWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cron", "durationMinutes"],
            "properties": {
              "cron": { "type": "string" },
              "durationMinutes": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "breakGlassRole": { "type": "string" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
