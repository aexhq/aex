{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aex.dev/release/v1/resolved-placement.json",
  "title": "aex.resolved-placement.v1",
  "description": "A private-values document, governed by a public schema, that maps public artifact digests to exact hosted destinations. placementDigest is sha256 over RFC 8785 canonical bytes with placementDigest removed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "placementDigest", "releaseId", "bindingDigest", "artifacts"],
  "properties": {
    "schema": { "const": "aex.resolved-placement.v1" },
    "placementDigest": { "$ref": "#/$defs/sha256" },
    "releaseId": { "$ref": "#/$defs/sha256" },
    "bindingDigest": { "$ref": "#/$defs/sha256" },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{2,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactDigest", "sizeBytes", "destination"],
        "properties": {
          "artifactDigest": { "$ref": "#/$defs/sha256" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "microvmImage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["imageArn", "imageVersion"],
            "properties": {
              "imageArn": {
                "type": "string",
                "pattern": "^arn:aws[a-z-]*:lambda:[a-z0-9-]+:[0-9]{12}:microvm-image:[A-Za-z0-9_-]{1,64}$"
              },
              "imageVersion": { "type": "string", "minLength": 1, "maxLength": 2048 }
            }
          },
          "destination": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "bucket", "key", "objectVersionId", "checksumSha256"],
                "properties": {
                  "kind": { "const": "s3" },
                  "bucket": { "type": "string", "minLength": 3 },
                  "key": { "type": "string", "minLength": 1 },
                  "objectVersionId": { "type": "string", "minLength": 1 },
                  "checksumSha256": { "$ref": "#/$defs/sha256" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "repository", "manifestDigest"],
                "properties": {
                  "kind": { "const": "oci" },
                  "repository": { "type": "string", "minLength": 1 },
                  "manifestDigest": { "$ref": "#/$defs/sha256" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "projectId", "deploymentId"],
                "properties": {
                  "kind": { "const": "vercel" },
                  "projectId": { "type": "string", "minLength": 1 },
                  "deploymentId": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
