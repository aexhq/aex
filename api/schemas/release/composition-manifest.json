{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aex.dev/release/v1/composition-manifest.json",
  "title": "aex.composition-manifest.v1",
  "description": "A complete, immutable, plane-neutral composition. Production promotes one of these; a one-service release creates a new complete manifest whose only change is that unit's digest. `releaseId` is the digest of the canonical bytes with `releaseId` and `annotations` removed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseId",
    "contractDigest",
    "source",
    "releaseTool",
    "units",
    "migrations",
    "infra",
    "order",
    "policy"
  ],
  "properties": {
    "schema": { "const": "aex.composition-manifest.v1" },
    "releaseId": { "$ref": "#/$defs/sha256" },
    "contractDigest": { "$ref": "#/$defs/sha256" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha", "workflowRunId", "workflowRunAttempt"],
      "properties": {
        "repository": { "const": "aexhq/aex" },
        "commitSha": { "$ref": "#/$defs/sha1" },
        "workflowRunId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "workflowRunAttempt": { "type": "integer", "minimum": 1 }
      }
    },
    "releaseTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest", "sizeBytes", "uri", "target"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "uri": { "type": "string", "pattern": "^https://github\\.com/aexhq/aex/releases/download/main-[0-9a-f]{40}-run-[1-9][0-9]*-attempt-[1-9][0-9]*/aex-release-tool$" },
        "target": { "const": "x86_64-unknown-linux-musl" }
      }
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{2,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "envelopeDigest",
          "artifactDigest",
          "sizeBytes",
          "location",
          "target",
          "configSchemaVersion",
          "adjacent"
        ],
        "properties": {
          "kind": { "type": "string" },
          "envelopeDigest": { "$ref": "#/$defs/sha256" },
          "artifactDigest": { "$ref": "#/$defs/sha256" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "uri", "immutable"],
            "properties": {
              "kind": { "enum": ["github-release", "oci", "s3", "ecr", "npm", "gha-artifact", "local"] },
              "uri": { "type": "string" },
              "immutable": { "const": true },
              "objectVersionId": { "type": "string" }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "github-release" } }, "required": ["kind"] },
                "then": { "properties": { "uri": { "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/releases/download/main-[0-9a-f]{40}-run-[1-9][0-9]*-attempt-[1-9][0-9]*/unit-[a-z][a-z0-9-]{2,63}-[0-9a-f]{64}\\.(zip|tar\\.gz)$" } } }
              },
              {
                "if": { "properties": { "kind": { "const": "oci" } }, "required": ["kind"] },
                "then": { "properties": { "uri": { "pattern": "^oci://ghcr\\.io/[a-z0-9._-]+/[a-z0-9._-]+-units/[a-z][a-z0-9-]{2,63}@sha256:[0-9a-f]{64}$" } } }
              }
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "architecture", "triple"],
            "properties": {
              "os": { "enum": ["linux", "none"] },
              "architecture": { "enum": ["arm64", "amd64", "none"] },
              "triple": { "type": "string" },
              "libcVersion": { "type": "string" }
            }
          },
          "ociIndexDigest": { "$ref": "#/$defs/sha256" },
          "ociChildDigest": { "$ref": "#/$defs/sha256" },
          "configSchemaVersion": { "type": "integer", "minimum": 1 },
          "requiredCentralHead": { "type": "string", "pattern": "^[0-9]{14}$" },
          "lambda": { "$ref": "#/$defs/lambdaShape" },
          "fargate": { "$ref": "#/$defs/fargateShape" },
          "microvm": { "$ref": "#/$defs/microvmShape" },
          "adjacent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storageCompatible", "protocolCompatible", "rollbackEligible"],
            "properties": {
              "storageCompatible": { "type": "boolean" },
              "protocolCompatible": { "type": "boolean" },
              "rollbackEligible": { "type": "boolean" },
              "rationale": { "type": "string", "minLength": 8 }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["rust-lambda", "ts-lambda"] } }, "required": ["kind"] },
            "then": { "required": ["lambda"] },
            "else": { "properties": { "lambda": false } }
          },
          {
            "if": { "properties": { "kind": { "enum": ["rust-oci-service", "rust-oci-task"] } }, "required": ["kind"] },
            "then": { "required": ["fargate"] },
            "else": { "properties": { "fargate": false } }
          },
          {
            "if": { "properties": { "kind": { "const": "microvm-image" } }, "required": ["kind"] },
            "then": { "required": ["microvm"] },
            "else": { "properties": { "microvm": false } }
          },
          {
            "if": { "properties": { "kind": { "const": "rust-oci-service" } }, "required": ["kind"] },
            "then": { "properties": { "fargate": { "properties": { "port": { "minimum": 1 } } } } }
          },
          {
            "if": { "properties": { "kind": { "const": "rust-oci-task" } }, "required": ["kind"] },
            "then": { "properties": { "fargate": { "properties": { "desiredCount": { "const": 0 }, "port": { "const": 0 } } } } }
          }
        ]
      }
    },
    "packages": {
      "type": "object",
      "propertyNames": { "enum": ["npm", "crates"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "integrity"],
          "properties": {
            "version": {
              "type": "string",
              "description": "An exact version. A range is rejected by `manifest validate --strict-environment-scan`.",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
            },
            "integrity": { "type": "string" },
            "provenance": { "type": "boolean" }
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["central", "regional"],
      "properties": {
        "central": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundleDigest", "head"],
          "properties": {
            "bundleDigest": { "$ref": "#/$defs/sha256" },
            "head": { "type": "string", "pattern": "^[0-9]{14}$" }
          }
        },
        "regional": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundleDigest", "bundleSizeBytes", "bundleUri", "definitionsDigest", "generation"],
          "properties": {
            "bundleDigest": { "$ref": "#/$defs/sha256" },
            "bundleSizeBytes": { "type": "integer", "minimum": 1 },
            "bundleUri": { "type": "string", "pattern": "^https://github\\.com/aexhq/aex/releases/download/main-[0-9a-f]{40}-run-[1-9][0-9]*-attempt-[1-9][0-9]*/regional-tables\\.json$" },
            "definitionsDigest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
            "generation": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleBundleDigest", "moduleBundleSizeBytes", "moduleBundleUri", "terraformVersion", "providerVersions"],
      "properties": {
        "moduleBundleDigest": { "$ref": "#/$defs/sha256" },
        "moduleBundleSizeBytes": { "type": "integer", "minimum": 1 },
        "moduleBundleUri": { "type": "string", "pattern": "^https://github\\.com/aexhq/aex/releases/download/main-[0-9a-f]{40}-run-[1-9][0-9]*-attempt-[1-9][0-9]*/terraform-modules\\.tar\\.gz$" },
        "terraformVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "providerVersions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "catalogs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } },
    "order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "units", "mode", "rationale"],
        "properties": {
          "name": { "type": "string" },
          "units": { "type": "array", "items": { "type": "string" } },
          "mode": { "enum": ["parallel", "sequential"] },
          "rationale": { "type": "string", "minLength": 8 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolchainChannel",
        "artifactPolicyDigest",
        "freshnessPolicyDigest",
        "sourcePolicyVersion"
      ],
      "properties": {
        "toolchainChannel": { "const": "1.97.1" },
        "artifactPolicyDigest": { "$ref": "#/$defs/sha256" },
        "freshnessPolicyDigest": { "$ref": "#/$defs/sha256" },
        "sourcePolicyVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "annotations": {
      "description": "Human text. Excluded from the release identity, so a changelog edit does not mint a new release.",
      "type": "object"
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "lambdaShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryMiB", "timeoutS", "reservedConcurrency"],
      "properties": {
        "memoryMiB": { "type": "integer", "minimum": 128, "maximum": 10240 },
        "timeoutS": { "type": "integer", "minimum": 1, "maximum": 900 },
        "reservedConcurrency": { "type": "integer", "minimum": 0 }
      }
    },
    "fargateShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memoryMiB", "desiredCount", "stopTimeoutS", "port"],
      "properties": {
        "cpu": { "type": "integer", "minimum": 1 },
        "memoryMiB": { "type": "integer", "minimum": 1 },
        "desiredCount": { "type": "integer", "minimum": 0 },
        "stopTimeoutS": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "microvmShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "minimumMemoryMiB", "browser"],
      "properties": {
        "variant": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "minimumMemoryMiB": { "type": "integer", "minimum": 1 },
        "browser": { "type": "boolean" }
      }
    }
  }
}
