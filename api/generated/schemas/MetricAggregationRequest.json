{
  "$id": "https://schemas.aex.dev/v1/MetricAggregationRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A bounded metric aggregation.",
  "properties": {
    "calculation": {
      "$ref": "aex:schema:MetricAggregationCalculation",
      "description": "What to compute."
    },
    "cursor": {
      "description": "Continuation token.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-cursor": true
    },
    "filter": {
      "$ref": "aex:schema:ObservationFilter",
      "description": "The bounded filter."
    },
    "groupBy": {
      "description": "Grouping attribute paths.",
      "items": {
        "maxLength": 256,
        "minLength": 0,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "limit": {
      "description": "Page size.",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "metric": {
      "description": "The metric name.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "timeRange": {
      "$ref": "aex:schema:TimeRange",
      "description": "The observation-time window."
    }
  },
  "required": [
    "calculation",
    "metric",
    "timeRange"
  ],
  "title": "MetricAggregationRequest",
  "type": "object"
}
