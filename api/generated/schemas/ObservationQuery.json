{
  "$id": "https://schemas.aex.dev/v1/ObservationQuery.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A bounded, paged observation read.",
  "properties": {
    "consistency": {
      "$ref": "aex:schema:ObservationConsistency",
      "description": "How much must be observed."
    },
    "cursor": {
      "description": "Continuation token.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-cursor": true
    },
    "filter": {
      "$ref": "aex:schema:ObservationFilter",
      "description": "The bounded filter."
    },
    "limit": {
      "description": "Page size.",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "order": {
      "$ref": "aex:schema:ObservationOrder",
      "description": "Walk direction."
    },
    "signal": {
      "$ref": "aex:schema:ObservationSignal",
      "description": "Which signal."
    },
    "timeRange": {
      "$ref": "aex:schema:TimeRange",
      "description": "The observation-time window."
    }
  },
  "required": [
    "signal",
    "timeRange"
  ],
  "title": "ObservationQuery",
  "type": "object"
}
