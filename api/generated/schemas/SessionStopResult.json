{
  "$id": "https://schemas.aex.dev/v1/SessionStopResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The result of a stop operation.",
  "properties": {
    "changed": {
      "description": "Whether anything was actually stopped.",
      "type": "boolean"
    },
    "sessionId": {
      "description": "The session.",
      "pattern": "^ses_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "session"
    },
    "sessionRevision": {
      "description": "The revision after the stop.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "changed",
    "sessionId",
    "sessionRevision"
  ],
  "title": "SessionStopResult",
  "type": "object"
}
