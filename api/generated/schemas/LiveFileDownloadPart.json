{
  "$id": "https://schemas.aex.dev/v1/LiveFileDownloadPart.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One fixed range and its expected digest in an exact live-file version.",
  "properties": {
    "offset": {
      "description": "The first byte in the whole file.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string"
    },
    "partNumber": {
      "description": "The one-based download part.",
      "maximum": 1280,
      "minimum": 1,
      "type": "integer"
    },
    "sha256": {
      "description": "SHA-256 the SDK must verify before retaining the part.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sizeBytes": {
      "description": "The exact range size.",
      "maximum": 4194304,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "offset",
    "partNumber",
    "sha256",
    "sizeBytes"
  ],
  "title": "LiveFileDownloadPart",
  "type": "object"
}
