{
  "$id": "https://schemas.aex.dev/v1/DashboardSessionRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete a GitHub OAuth browser sign-in using PKCE-bound state.",
  "properties": {
    "code": {
      "description": "Single-use GitHub authorization code.",
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "codeVerifier": {
      "description": "The browser-held PKCE verifier.",
      "maxLength": 128,
      "minLength": 43,
      "type": "string"
    },
    "state": {
      "description": "The echoed S256 challenge.",
      "maxLength": 128,
      "minLength": 43,
      "type": "string"
    }
  },
  "required": [
    "code",
    "codeVerifier",
    "state"
  ],
  "title": "DashboardSessionRequest",
  "type": "object"
}
