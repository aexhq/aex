{
  "$id": "https://schemas.aex.dev/v1/SecretRef.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A reference to a workspace secret by name. Values never appear here.",
  "properties": {
    "name": {
      "description": "The secret name.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "SecretRef",
  "type": "object"
}
