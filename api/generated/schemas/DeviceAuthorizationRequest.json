{
  "$id": "https://schemas.aex.dev/v1/DeviceAuthorizationRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Begin the CLI device-authorization flow.",
  "properties": {
    "clientId": {
      "description": "The public client identifier.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "scopes": {
      "description": "The scopes requested.",
      "items": {
        "type": "string",
        "x-aex-registry": "scopes"
      },
      "maxItems": 64,
      "type": "array"
    }
  },
  "required": [
    "clientId",
    "scopes"
  ],
  "title": "DeviceAuthorizationRequest",
  "type": "object"
}
