{
  "$id": "https://schemas.aex.dev/v1/RegisteredFileRead.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a registered file is, as published. The payload bytes are referenced, never inlined; fetch them with a download grant.",
  "properties": {
    "content": {
      "$ref": "aex:schema:ContentRef",
      "description": "The stored bytes."
    },
    "mediaType": {
      "description": "Declared media type.",
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "mode": {
      "$ref": "aex:schema:RegisteredFileMode",
      "description": "POSIX mode."
    }
  },
  "required": [
    "content",
    "mediaType",
    "mode"
  ],
  "title": "RegisteredFileRead",
  "type": "object"
}
