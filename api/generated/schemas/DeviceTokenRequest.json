{
  "$id": "https://schemas.aex.dev/v1/DeviceTokenRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exchange an approved device code for an account token.",
  "properties": {
    "clientId": {
      "description": "The public client identifier.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "deviceCode": {
      "description": "The polling secret.",
      "maxLength": 256,
      "minLength": 32,
      "type": "string"
    }
  },
  "required": [
    "clientId",
    "deviceCode"
  ],
  "title": "DeviceTokenRequest",
  "type": "object"
}
