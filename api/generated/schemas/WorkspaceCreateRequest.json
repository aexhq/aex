{
  "$id": "https://schemas.aex.dev/v1/WorkspaceCreateRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Create a region-pinned workspace. Region is required and immutable.",
  "properties": {
    "name": {
      "description": "Display name.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "organizationId": {
      "description": "The owning organization.",
      "pattern": "^org_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "organization"
    },
    "region": {
      "description": "Where the workspace lives, forever.",
      "enum": [
        "us-east-1",
        "us-east-2",
        "us-west-2",
        "ap-northeast-1",
        "eu-west-1"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "organizationId",
    "region"
  ],
  "title": "WorkspaceCreateRequest",
  "type": "object"
}
