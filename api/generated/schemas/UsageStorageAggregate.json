{
  "$id": "https://schemas.aex.dev/v1/UsageStorageAggregate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Retained bytes over time.",
  "properties": {
    "attribution": {
      "$ref": "aex:schema:UsageAttribution",
      "description": "What it is attributed to."
    },
    "byteMinutes": {
      "description": "Byte-minutes of retained storage.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string"
    },
    "settlement": {
      "$ref": "aex:schema:UsageSettlement",
      "description": "Whether this item is settled as of `completeThrough`."
    }
  },
  "required": [
    "attribution",
    "byteMinutes",
    "settlement"
  ],
  "title": "UsageStorageAggregate",
  "type": "object"
}
