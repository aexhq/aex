{
  "$id": "https://schemas.aex.dev/v1/LiveFileDownloadRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Open one regular file without following a symlink, auto-resuming the same generation.",
  "properties": {
    "ifGenerationId": {
      "description": "Require this exact retained generation.",
      "pattern": "^gen_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "generation"
    },
    "path": {
      "description": "The regular file to open.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-path": "posix"
    }
  },
  "required": [
    "path"
  ],
  "title": "LiveFileDownloadRequest",
  "type": "object"
}
