{
  "$id": "https://schemas.aex.dev/v1/UploadCreateRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stage a large registered-resource value.",
  "properties": {
    "contentType": {
      "description": "The media type.",
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "sha256": {
      "description": "The exact whole-object hash.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sizeBytes": {
      "description": "The exact object size.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string"
    }
  },
  "required": [
    "contentType",
    "sha256",
    "sizeBytes"
  ],
  "title": "UploadCreateRequest",
  "type": "object"
}
