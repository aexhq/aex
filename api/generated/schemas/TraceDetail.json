{
  "$id": "https://schemas.aex.dev/v1/TraceDetail.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One assembled trace and the observations it was assembled from.",
  "properties": {
    "coverage": {
      "$ref": "aex:schema:ObservationCoverage",
      "description": "What the assembly covers."
    },
    "spans": {
      "description": "The spans.",
      "items": {
        "$ref": "aex:schema:Observation"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "summary": {
      "$ref": "aex:schema:TraceSummary",
      "description": "The header."
    }
  },
  "required": [
    "coverage",
    "spans",
    "summary"
  ],
  "title": "TraceDetail",
  "type": "object"
}
