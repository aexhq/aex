{
  "$id": "https://schemas.aex.dev/v1/AutoTopupPolicyRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Replace the automatic top-up policy; every field is required.",
  "properties": {
    "amountCents": {
      "description": "How much each automatic top-up adds.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string",
      "x-aex-money": "cents"
    },
    "enabled": {
      "description": "Whether automatic top-up runs.",
      "type": "boolean"
    },
    "thresholdCents": {
      "description": "Balance at or below which a top-up is attempted.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string",
      "x-aex-money": "cents"
    }
  },
  "required": [
    "amountCents",
    "enabled",
    "thresholdCents"
  ],
  "title": "AutoTopupPolicyRequest",
  "type": "object"
}
