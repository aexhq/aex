{
  "$id": "https://schemas.aex.dev/v1/FileListRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "List persisted files; an observational read that never mutates.",
  "properties": {
    "cursor": {
      "description": "Continuation token.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-cursor": true
    },
    "limit": {
      "description": "Page size.",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "path": {
      "description": "Subtree to list; defaults to the root.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-path": "posix"
    },
    "recursive": {
      "description": "Whether to descend; defaults to false.",
      "type": "boolean"
    }
  },
  "required": [],
  "title": "FileListRequest",
  "type": "object"
}
