{
  "$id": "https://schemas.aex.dev/v1/SessionLineage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable provenance. A clone records its origin exactly once.",
  "properties": {
    "cloneOperationId": {
      "description": "The operation that cloned it.",
      "pattern": "^op_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "operation"
    },
    "clonedAtPersistRevision": {
      "description": "The source revision cloned from.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "originSessionId": {
      "description": "The session this was cloned from.",
      "pattern": "^ses_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "session"
    }
  },
  "required": [],
  "title": "SessionLineage",
  "type": "object"
}
