{
  "$id": "https://schemas.aex.dev/v1/ErrorDetailsRegion.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The authoritative placement of the workspace.",
  "properties": {
    "apiUrl": {
      "description": "The regional host to reissue against.",
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
    },
    "expected": {
      "description": "Where the workspace actually lives.",
      "enum": [
        "us-east-1",
        "us-east-2",
        "us-west-2",
        "ap-northeast-1",
        "eu-west-1"
      ],
      "type": "string"
    }
  },
  "required": [
    "apiUrl",
    "expected"
  ],
  "title": "ErrorDetailsRegion",
  "type": "object"
}
