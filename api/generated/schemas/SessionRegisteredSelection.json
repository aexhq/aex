{
  "$id": "https://schemas.aex.dev/v1/SessionRegisteredSelection.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Files resolved once at session admission; later workspace overwrites cannot mutate this manifest.",
  "properties": {
    "mounts": {
      "description": "Explicit name-to-path mounts.",
      "items": {
        "$ref": "aex:schema:WorkspaceFileMount"
      },
      "maxItems": 256,
      "type": "array"
    }
  },
  "required": [
    "mounts"
  ],
  "title": "SessionRegisteredSelection",
  "type": "object"
}
