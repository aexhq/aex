{
  "$id": "https://schemas.aex.dev/v1/CredentialRebindResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The result of a credential-rebind operation.",
  "properties": {
    "custodyRevision": {
      "description": "The custody revision after the rebind.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "secrets": {
      "description": "The bound secrets.",
      "items": {
        "$ref": "aex:schema:SecretRef"
      },
      "maxItems": 64,
      "type": "array"
    },
    "sessionId": {
      "description": "The session.",
      "pattern": "^ses_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "session"
    }
  },
  "required": [
    "custodyRevision",
    "secrets",
    "sessionId"
  ],
  "title": "CredentialRebindResult",
  "type": "object"
}
