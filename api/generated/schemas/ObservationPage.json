{
  "$id": "https://schemas.aex.dev/v1/ObservationPage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One page of observations plus the coverage it is complete over.",
  "properties": {
    "coverage": {
      "$ref": "aex:schema:ObservationCoverage",
      "description": "What the answer covers."
    },
    "items": {
      "description": "The page.",
      "items": {
        "$ref": "aex:schema:Observation"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "nextCursor": {
      "description": "Continuation token.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-cursor": true
    }
  },
  "required": [
    "coverage",
    "items"
  ],
  "title": "ObservationPage",
  "type": "object"
}
