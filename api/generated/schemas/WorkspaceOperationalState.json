{
  "$id": "https://schemas.aex.dev/v1/WorkspaceOperationalState.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The fixed workspace's inherited personal-account state.",
  "properties": {
    "accountId": {
      "description": "The personal account.",
      "pattern": "^acc_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "account"
    },
    "state": {
      "$ref": "aex:schema:AccountOperationalState",
      "description": "The inherited state."
    }
  },
  "required": [
    "accountId",
    "state"
  ],
  "title": "WorkspaceOperationalState",
  "type": "object"
}
