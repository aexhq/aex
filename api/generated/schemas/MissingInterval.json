{
  "$id": "https://schemas.aex.dev/v1/MissingInterval.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A known hole in the ordered series.",
  "properties": {
    "gapId": {
      "description": "The recorded gap.",
      "pattern": "^gap_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "telemetry_gap"
    },
    "range": {
      "$ref": "aex:schema:TimeRange",
      "description": "The affected window."
    }
  },
  "required": [
    "gapId",
    "range"
  ],
  "title": "MissingInterval",
  "type": "object"
}
