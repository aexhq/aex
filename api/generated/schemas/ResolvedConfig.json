{
  "$id": "https://schemas.aex.dev/v1/ResolvedConfig.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Customer-safe frozen session configuration; all plaintext secrets are omitted.",
  "properties": {
    "compute": {
      "$ref": "aex:schema:ResolvedCompute",
      "description": "Present only when sandbox is enabled."
    },
    "lifecycle": {
      "$ref": "aex:schema:SessionLifecyclePolicy",
      "description": "Immutable session bounds."
    },
    "mcpServerNames": {
      "description": "Frozen server names; secrets and transport credentials are omitted.",
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "model": {
      "description": "Current model selected at admission.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "network": {
      "$ref": "aex:schema:ResolvedNetwork",
      "description": "Present only when sandbox is enabled."
    },
    "packages": {
      "description": "Resolved setup packages.",
      "items": {
        "$ref": "aex:schema:PackageRequest"
      },
      "maxItems": 64,
      "type": "array"
    },
    "provider": {
      "$ref": "aex:schema:ProviderId",
      "description": "Provider."
    },
    "registered": {
      "$ref": "aex:schema:SessionRegisteredSelection",
      "description": "Frozen mount selection; hashes remain private."
    },
    "sandboxEnabled": {
      "description": "Whether the one sandbox exists.",
      "type": "boolean"
    }
  },
  "required": [
    "lifecycle",
    "mcpServerNames",
    "model",
    "packages",
    "provider",
    "registered",
    "sandboxEnabled"
  ],
  "title": "ResolvedConfig",
  "type": "object"
}
