{
  "$id": "https://schemas.aex.dev/v1/SessionCredentials.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Which workspace secrets the session may hold custody of.",
  "properties": {
    "secrets": {
      "description": "The named secrets.",
      "items": {
        "$ref": "aex:schema:SecretRef"
      },
      "maxItems": 64,
      "type": "array"
    }
  },
  "required": [
    "secrets"
  ],
  "title": "SessionCredentials",
  "type": "object"
}
