{
  "$id": "https://schemas.aex.dev/v1/ApiKeyCreateRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Mint a key for the account's fixed workspace.",
  "properties": {
    "name": {
      "description": "Display name.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "scopes": {
      "description": "Launch scopes to grant.",
      "items": {
        "type": "string",
        "x-aex-registry": "scopes"
      },
      "maxItems": 16,
      "type": "array"
    },
    "workspaceId": {
      "description": "Must name the fixed workspace.",
      "pattern": "^wsp_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "workspace"
    }
  },
  "required": [
    "name",
    "scopes",
    "workspaceId"
  ],
  "title": "ApiKeyCreateRequest",
  "type": "object"
}
