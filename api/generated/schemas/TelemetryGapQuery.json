{
  "$id": "https://schemas.aex.dev/v1/TelemetryGapQuery.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A bounded query over recorded gaps.",
  "properties": {
    "cursor": {
      "description": "Continuation token.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-cursor": true
    },
    "limit": {
      "description": "Page size.",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "recoverable": {
      "description": "Restrict by recoverability.",
      "type": "boolean"
    },
    "signals": {
      "description": "Restrict to these signals.",
      "items": {
        "$ref": "aex:schema:ObservationSignal"
      },
      "maxItems": 6,
      "type": "array"
    },
    "timeRange": {
      "$ref": "aex:schema:TimeRange",
      "description": "The observation-time window."
    }
  },
  "required": [
    "timeRange"
  ],
  "title": "TelemetryGapQuery",
  "type": "object"
}
