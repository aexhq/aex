{
  "$id": "https://schemas.aex.dev/v1/RegisteredToolRead.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a registered tool is, as published.",
  "properties": {
    "bundle": {
      "$ref": "aex:schema:ContentRef",
      "description": "The stored bundle."
    },
    "bundleFormat": {
      "$ref": "aex:schema:BundleFormat",
      "description": "The bundle format."
    },
    "description": {
      "description": "What the tool does.",
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "entry": {
      "description": "Relative entry path inside the bundle.",
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "inputSchema": {
      "description": "JSON Schema 2020-12 for the arguments.",
      "x-aex-canonical-json": true
    }
  },
  "required": [
    "bundle",
    "bundleFormat",
    "description",
    "entry",
    "inputSchema"
  ],
  "title": "RegisteredToolRead",
  "type": "object"
}
