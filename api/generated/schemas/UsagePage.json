{
  "$id": "https://schemas.aex.dev/v1/UsagePage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One page of rated usage plus the frontiers that bound its completeness.",
  "properties": {
    "frontiers": {
      "description": "Pipeline frontiers.",
      "items": {
        "$ref": "aex:schema:UsageFrontier"
      },
      "maxItems": 100,
      "type": "array"
    },
    "items": {
      "description": "The page.",
      "items": {
        "$ref": "aex:schema:UsageAggregate"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "nextCursor": {
      "description": "Continuation token.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-cursor": true
    }
  },
  "required": [
    "frontiers",
    "items"
  ],
  "title": "UsagePage",
  "type": "object"
}
