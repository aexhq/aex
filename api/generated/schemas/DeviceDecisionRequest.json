{
  "$id": "https://schemas.aex.dev/v1/DeviceDecisionRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Approve or deny a pending device authorization by its user code.",
  "properties": {
    "decision": {
      "$ref": "aex:schema:DeviceDecision",
      "description": "What the person chose."
    },
    "userCode": {
      "description": "The short code the device displayed.",
      "maxLength": 16,
      "minLength": 6,
      "type": "string"
    }
  },
  "required": [
    "decision",
    "userCode"
  ],
  "title": "DeviceDecisionRequest",
  "type": "object"
}
