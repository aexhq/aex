{
  "$id": "https://schemas.aex.dev/v1/SessionCreateRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Create an eight-hour multi-turn session with one explicitly pinned BYOK provider credential.",
  "properties": {
    "approvalPolicy": {
      "$ref": "aex:schema:ApprovalPolicy",
      "description": "When to ask for a built-in tool decision."
    },
    "compute": {
      "$ref": "aex:schema:SessionComputeRequest",
      "description": "The baseline compute shape."
    },
    "metadata": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ],
        "x-aex-float": true
      },
      "description": "Caller-defined labels.",
      "maxProperties": 64,
      "type": "object"
    },
    "model": {
      "description": "The exact provider-native model id.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "network": {
      "$ref": "aex:schema:SessionNetworkRequest",
      "description": "The guest network policy."
    },
    "packages": {
      "description": "Packages to pre-install.",
      "items": {
        "$ref": "aex:schema:PackageRequest"
      },
      "maxItems": 64,
      "type": "array"
    },
    "provider": {
      "$ref": "aex:schema:ProviderId",
      "description": "The direct BYOK provider."
    },
    "providerCredentialId": {
      "description": "The exact BYOK binding; the platform never guesses between bindings.",
      "pattern": "^pcr_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "provider_credential"
    },
    "registered": {
      "$ref": "aex:schema:SessionRegisteredSelection",
      "description": "Opaque workspace files to mount."
    }
  },
  "required": [
    "model",
    "provider",
    "providerCredentialId"
  ],
  "title": "SessionCreateRequest",
  "type": "object"
}
