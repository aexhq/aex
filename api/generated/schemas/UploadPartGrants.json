{
  "$id": "https://schemas.aex.dev/v1/UploadPartGrants.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The presigned grants for the requested parts.",
  "properties": {
    "grants": {
      "description": "The grants.",
      "items": {
        "$ref": "aex:schema:UploadPartGrant"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "uploadId": {
      "description": "The staged upload.",
      "pattern": "^upl_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "upload"
    }
  },
  "required": [
    "grants",
    "uploadId"
  ],
  "title": "UploadPartGrants",
  "type": "object"
}
