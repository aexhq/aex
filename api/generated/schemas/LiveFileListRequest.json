{
  "$id": "https://schemas.aex.dev/v1/LiveFileListRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "List live workspace files, auto-resuming the same retained generation if suspended.",
  "properties": {
    "cursor": {
      "description": "Continuation token.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-cursor": true
    },
    "ifGenerationId": {
      "description": "Only read this exact generation.",
      "pattern": "^gen_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "generation"
    },
    "limit": {
      "description": "Page size.",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "path": {
      "description": "Subtree to list; defaults to the root.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-path": "posix"
    },
    "recursive": {
      "description": "Whether to descend; defaults to false.",
      "type": "boolean"
    }
  },
  "required": [],
  "title": "LiveFileListRequest",
  "type": "object"
}
