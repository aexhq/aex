{
  "$id": "https://schemas.aex.dev/v1/WorkspaceDiscardResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The result of a workspace-discard operation.",
  "properties": {
    "changed": {
      "description": "Whether a live workspace was actually discarded.",
      "type": "boolean"
    },
    "continuity": {
      "$ref": "aex:schema:WorkspaceContinuity",
      "description": "Continuity after the discard."
    },
    "sessionId": {
      "description": "The session.",
      "pattern": "^ses_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "session"
    }
  },
  "required": [
    "changed",
    "continuity",
    "sessionId"
  ],
  "title": "WorkspaceDiscardResult",
  "type": "object"
}
