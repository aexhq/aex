{
  "$id": "https://schemas.aex.dev/v1/LiveFileUploadPart.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One verified logical part retained by the exact MicroVM generation.",
  "properties": {
    "offset": {
      "description": "The first byte in the complete file.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string"
    },
    "partNumber": {
      "description": "The one-based logical part number.",
      "maximum": 1280,
      "minimum": 1,
      "type": "integer"
    },
    "sha256": {
      "description": "SHA-256 of this logical part.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sizeBytes": {
      "description": "The exact logical-part size.",
      "maximum": 4194304,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "offset",
    "partNumber",
    "sha256",
    "sizeBytes"
  ],
  "title": "LiveFileUploadPart",
  "type": "object"
}
