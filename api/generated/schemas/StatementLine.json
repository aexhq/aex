{
  "$id": "https://schemas.aex.dev/v1/StatementLine.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One priced category line. Lines sum exactly to the statement total.",
  "properties": {
    "category": {
      "$ref": "aex:schema:UsageCategory",
      "description": "The priced category."
    },
    "totalCents": {
      "description": "The line total.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string",
      "x-aex-money": "cents"
    }
  },
  "required": [
    "category",
    "totalCents"
  ],
  "title": "StatementLine",
  "type": "object"
}
