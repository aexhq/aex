{
  "$id": "https://schemas.aex.dev/v1/LiveFileStatRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stat one live workspace file.",
  "properties": {
    "consistency": {
      "$ref": "aex:schema:FileConsistency",
      "description": "How coherent the read must be."
    },
    "ifGenerationId": {
      "description": "Only read this exact generation.",
      "pattern": "^gen_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "generation"
    },
    "path": {
      "description": "The entry to stat.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-path": "posix"
    },
    "wake": {
      "$ref": "aex:schema:FileWakePolicy",
      "description": "Whether a retained session may be woken."
    }
  },
  "required": [
    "path"
  ],
  "title": "LiveFileStatRequest",
  "type": "object"
}
