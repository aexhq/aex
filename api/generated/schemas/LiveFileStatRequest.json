{
  "$id": "https://schemas.aex.dev/v1/LiveFileStatRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stat one live workspace file, auto-resuming the same retained generation if suspended.",
  "properties": {
    "ifGenerationId": {
      "description": "Only read this exact generation.",
      "pattern": "^gen_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string",
      "x-aex-id": "generation"
    },
    "path": {
      "description": "The entry to stat.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-path": "posix"
    }
  },
  "required": [
    "path"
  ],
  "title": "LiveFileStatRequest",
  "type": "object"
}
