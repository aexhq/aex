{
  "$id": "https://schemas.aex.dev/v1/SecretMetadataPage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One page of secret metadata.",
  "properties": {
    "items": {
      "description": "The page.",
      "items": {
        "$ref": "aex:schema:SecretMetadata"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "nextCursor": {
      "description": "Continuation token.",
      "maxLength": 4096,
      "type": "string",
      "x-aex-cursor": true
    }
  },
  "required": [
    "items"
  ],
  "title": "SecretMetadataPage",
  "type": "object"
}
