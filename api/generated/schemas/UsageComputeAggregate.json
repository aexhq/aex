{
  "$id": "https://schemas.aex.dev/v1/UsageComputeAggregate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Millicpu-milliseconds of guest compute.",
  "properties": {
    "attribution": {
      "$ref": "aex:schema:UsageAttribution",
      "description": "What it is attributed to."
    },
    "millicpuMilliseconds": {
      "description": "Millicpu-milliseconds.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string"
    }
  },
  "required": [
    "attribution",
    "millicpuMilliseconds"
  ],
  "title": "UsageComputeAggregate",
  "type": "object"
}
