{
  "$id": "https://schemas.aex.dev/v1/McpHeader.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One MCP request header whose value comes from a workspace secret.",
  "properties": {
    "name": {
      "description": "The header name.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "secretName": {
      "description": "The secret whose value is sent.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "name",
    "secretName"
  ],
  "title": "McpHeader",
  "type": "object"
}
