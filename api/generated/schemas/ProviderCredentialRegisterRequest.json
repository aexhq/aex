{
  "$id": "https://schemas.aex.dev/v1/ProviderCredentialRegisterRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Register a BYOK provider credential. This request carries plaintext.",
  "properties": {
    "apiKey": {
      "description": "The provider key; write-only, never returned.",
      "maxLength": 8192,
      "minLength": 8,
      "type": "string"
    },
    "name": {
      "description": "A human label.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "provider": {
      "$ref": "aex:schema:ProviderId",
      "description": "Which provider the credential is for."
    }
  },
  "required": [
    "apiKey",
    "name",
    "provider"
  ],
  "title": "ProviderCredentialRegisterRequest",
  "type": "object"
}
