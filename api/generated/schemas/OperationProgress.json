{
  "$id": "https://schemas.aex.dev/v1/OperationProgress.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Coarse progress; never a completion promise.",
  "properties": {
    "completed": {
      "description": "Units done.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string"
    },
    "phase": {
      "description": "The named phase.",
      "maxLength": 64,
      "minLength": 0,
      "type": "string"
    },
    "total": {
      "description": "Units expected.",
      "pattern": "^(0|[1-9]\\d*)$",
      "type": "string"
    }
  },
  "required": [
    "phase"
  ],
  "title": "OperationProgress",
  "type": "object"
}
