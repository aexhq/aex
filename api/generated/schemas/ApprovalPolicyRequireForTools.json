{
  "$id": "https://schemas.aex.dev/v1/ApprovalPolicyRequireForTools.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Named built-in tools require an explicit decision before they run.",
  "properties": {
    "tools": {
      "description": "Built-in tools that need approval.",
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    }
  },
  "required": [
    "tools"
  ],
  "title": "ApprovalPolicyRequireForTools",
  "type": "object"
}
