{
  "scopes": [
    {
      "description": "Read bootstrap and personal-account state.",
      "scope": "account:read"
    },
    {
      "description": "Close the caller's own browser session.",
      "scope": "account:write"
    },
    {
      "description": "List fixed-workspace API key metadata.",
      "scope": "api_keys:read"
    },
    {
      "description": "Mint and revoke fixed-workspace API keys.",
      "scope": "api_keys:write"
    },
    {
      "description": "Read prepaid balance, card metadata, transactions and rated usage.",
      "scope": "billing:read"
    },
    {
      "description": "Set up or remove cards and create manual top-up checkouts.",
      "scope": "billing:write"
    },
    {
      "description": "Read sessions, messages and telemetry.",
      "scope": "sessions:read"
    },
    {
      "description": "Create sessions, send messages, cancel and terminate.",
      "scope": "sessions:write"
    },
    {
      "description": "Admit irreversible session deletion.",
      "scope": "sessions:delete"
    },
    {
      "description": "Read current workspace files and mint downloads.",
      "scope": "resources:read"
    },
    {
      "description": "Overwrite/delete current workspace files and upload bytes.",
      "scope": "resources:write"
    }
  ]
}
