{
  "name": "@aexhq/contracts",
  "version": "0.13.10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git"
  },
  "description": "Public aex wire contracts, SDK transport helpers, and conformance-facing schemas.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:property": "vitest run property",
    "test:coverage": "vitest run --coverage"
  }
}
