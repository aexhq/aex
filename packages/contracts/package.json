{
  "name": "@aex/contracts",
  "version": "0.1.0",
  "description": "aex contracts: brain-hand ABI v1 and session API v1 types, generated from contracts/",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
