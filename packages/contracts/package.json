{
  "name": "@aexhq/contracts",
  "version": "0.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git"
  },
  "description": "Public aex wire contracts, SDK transport helpers, and conformance-facing schemas.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    },
    "./subagent-runtime": {
      "types": "./dist/subagent-runtime.d.ts",
      "import": "./dist/subagent-runtime.js",
      "default": "./dist/subagent-runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "dependencies": {
    "fflate": "0.8.2",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "bun ../../scripts/with-generated-dist-lock.mjs bun run build:unlocked",
    "build:unlocked": "bun ./scripts/clean-dist.mjs && tsc -p tsconfig.build.json && bun ../../scripts/cicd/check-generated-dist-closure.mjs dist",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run test:unit",
    "test:unit": "mkdir -p .tmp && bun test --isolate --reporter=junit --reporter-outfile=.tmp/junit-test-unit.xml && node ../../scripts/cicd/assert-no-skips.mjs .tmp/junit-test-unit.xml",
    "test:property": "mkdir -p .tmp && bun test --isolate --reporter=junit --reporter-outfile=.tmp/junit-test-property.xml property && node ../../scripts/cicd/assert-no-skips.mjs .tmp/junit-test-property.xml",
    "test:coverage": "bun test --isolate --coverage"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.1.0",
    "@types/bun": "1.3.14"
  }
}
