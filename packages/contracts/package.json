    "test": "tsc -p tsconfig.json && node --test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.9.2"
  }
