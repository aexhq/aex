{
  "name": "@aexhq/session-protocol",
  "version": "0.3.1",
  "description": "Generated session protocol types and transport client used by the Aex SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git",
    "directory": "packages/session-protocol"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/generated/session.d.ts",
      "import": "./dist/generated/session.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "zod": ">=4.4.3 <5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2",
    "zod": "4.4.3"
  }
}
