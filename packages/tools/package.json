{
  "name": "@aexhq/tools",
  "version": "0.2.6",
  "description": "Official tool selections for Aex sessions",
  "license": "Apache-2.0",
  "homepage": "https://aex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git",
    "directory": "packages/tools"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "node ../cli/dist/index.js tools build",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@aexhq/sdk": "0.57.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aexhq/cli": "0.28.5",
    "typescript": "^5.9.2"
  },
  "aex": {
    "tools": {
      "entries": {
        "./bash": "./src/bash.ts",
        "./edit": "./src/edit.ts",
        "./glob": "./src/glob.ts",
        "./grep": "./src/grep.ts",
        "./ls": "./src/ls.ts",
        "./read": "./src/read.ts",
        "./todo": "./src/todo.ts",
        "./write": "./src/write.ts"
      },
      "outDir": "./dist"
    }
  }
}
