{
  "name": "@aexhq/conformance",
  "version": "0.29.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git"
  },
  "private": false,
  "license": "Apache-2.0",
  "description": "Public conformance matchers for aex-compatible event streams and structured errors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:parity-deps": "bun run --cwd ../.. --filter @aexhq/sdk build && bun run --cwd ../.. --filter @aexhq/cli build",
    "lint": "bun ../../scripts/with-generated-dist-lock.mjs bun run lint:unlocked",
    "lint:unlocked": "bun run build:parity-deps && tsc --noEmit -p tsconfig.json",
    "pretest": "bun run build",
    "test:unit": "bun run build:parity-deps && vitest run"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
