{
  "name": "@aexhq/sdk",
  "version": "0.46.4",
  "description": "TypeScript SDK for autonomous agent sessions with managed Vercel AI Gateway model access.",
  "license": "Apache-2.0",
  "keywords": [
    "aex",
    "agent",
    "sdk",
    "autonomous-agents",
    "agent-runtime",
    "typescript"
  ],
  "homepage": "https://aex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/aexhq/aex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "aex": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "bun ../../scripts/with-generated-dist-lock.mjs bun run build:unlocked",
    "build:unlocked": "bun ./scripts/clean-dist.mjs && bun run --cwd ../.. --filter @aexhq/contracts build && tsc -p tsconfig.build.json && bun run --cwd ../.. --filter @aexhq/cli build && bun ./scripts/bundle-cli.mjs && bun ./scripts/inline-contracts.mjs",
    "lint": "bun ../../scripts/with-generated-dist-lock.mjs bun run lint:unlocked",
    "lint:unlocked": "tsc --noEmit",
    "typecheck": "bun ../../scripts/with-generated-dist-lock.mjs bun run typecheck:unlocked",
    "typecheck:unlocked": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun ../../scripts/with-generated-dist-lock.mjs bun run test:unit:unlocked",
    "test:unit:unlocked": "mkdir -p .tmp && bun test --isolate --reporter=junit --reporter-outfile=.tmp/junit-test-unit.xml test/unit && node ../../scripts/cicd/assert-no-skips.mjs .tmp/junit-test-unit.xml",
    "test:security": "bun ../../scripts/with-generated-dist-lock.mjs bun run test:security:unlocked",
    "test:security:unlocked": "mkdir -p .tmp && bun test --isolate --reporter=junit --reporter-outfile=.tmp/junit-test-security.xml test/security && node ../../scripts/cicd/assert-no-skips.mjs .tmp/junit-test-security.xml",
    "test:property": "mkdir -p .tmp && bun test --isolate --reporter=junit --reporter-outfile=.tmp/junit-test-property.xml property && node ../../scripts/cicd/assert-no-skips.mjs .tmp/junit-test-property.xml",
    "test:coverage": "bun test --isolate --coverage test/unit",
    "prepack": "bun run build",
    "pack:dry-run": "bun ../../scripts/with-generated-dist-lock.mjs bun pm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "@aexhq/cli": "workspace:*",
    "@aexhq/contracts": "workspace:*",
    "@types/bun": "1.3.14"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "fflate": "0.8.2",
    "ignore": "7.0.5",
    "zod": "4.4.3"
  }
}
