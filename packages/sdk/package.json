{
  "name": "@aexhq/sdk",
  "version": "0.52.0",
  "description": "Zero-dependency TypeScript SDK for the AEX v1 public API.",
  "aex": {
    "owner": "clients",
    "role": "client",
    "artifact": "npm_package",
    "layers": [
      "unit",
      "user"
    ],
    "concerns": [
      "contract",
      "compatibility",
      "property",
      "security"
    ],
    "seams": [
      "npm.registry.publish"
    ],
    "security_tier": "public_edge",
    "risk": [
      "generated_code"
    ],
    "scenarios": ["packed.sdk-install-node", "packed.sdk-install-bun"],
    "targets": {
      "conformance": "unit",
      "security": "unit",
      "compatibility": "unit",
      "packed_user": "user"
    },
    "not_applicable": {
      "live_suite": "clean-install and packed-tarball evidence is package-owned; the SDK has no deployed endpoint"
    }
  },
  "license": "Apache-2.0",
  "keywords": [
    "aex",
    "agent",
    "sdk",
    "autonomous-agents",
    "agent-runtime",
    "typescript"
  ],
  "homepage": "https://aex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/aexhq/aex/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node/session-files": {
      "types": "./dist/node/session-files.d.ts",
      "import": "./dist/node/session-files.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun test --isolate test/unit",
    "test:coverage": "bun test --isolate --coverage test/unit",
    "prepack": "bun run build",
    "pack:dry-run": "bun pm pack --dry-run --ignore-scripts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.3.14"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.14"
  }
}
