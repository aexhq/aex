{
  "name": "@aexhq/cli",
  "version": "0.25.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cli.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "bin": {
    "aex": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "bun run --cwd ../.. --filter @aexhq/contracts build && tsc -p tsconfig.build.json && bun ./scripts/finalize-bundle.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "pretest": "bun run build",
    "test": "bun run test:unit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aexhq/contracts": "workspace:*",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
