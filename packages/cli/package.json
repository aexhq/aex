{
  "name": "@aexhq/cli",
  "version": "0.33.0",
  "description": "The resource-oriented aex v1 command-line interface for sessions, operations, files, telemetry, and account resources.",
  "license": "Apache-2.0",
  "keywords": [
    "aex",
    "agent",
    "cli",
    "autonomous-agents",
    "agent-runtime"
  ],
  "homepage": "https://aex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexhq/aex.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/aexhq/aex/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "./dist/cli.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "aex": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "bun run --cwd ../sdk build && bun ../../scripts/with-generated-dist-lock.mjs bun run build:unlocked",
    "build:unlocked": "tsc -p tsconfig.build.json && bun ./scripts/finalize-bundle.mjs",
    "lint": "bun run --cwd ../sdk build && bun ../../scripts/with-generated-dist-lock.mjs bun run lint:unlocked",
    "lint:unlocked": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run --cwd ../sdk build && tsc --noEmit -p tsconfig.json",
    "pretest": "bun run build",
    "test": "bun run test:unit",
    "test:unit": "bun ../../scripts/with-generated-dist-lock.mjs bun run test:unit:unlocked",
    "test:unit:unlocked": "mkdir -p .tmp && bun test --isolate --reporter=junit --reporter-outfile=.tmp/junit-test-unit.xml && node ../../scripts/cicd/assert-no-skips.mjs .tmp/junit-test-unit.xml"
  },
  "devDependencies": {
    "@aexhq/contracts": "workspace:*",
    "@aexhq/sdk": "workspace:*",
    "@types/bun": "1.3.14",
    "esbuild": "^0.28.0"
  }
}
