{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssuedKey",
  "type": "object",
  "properties": {
    "key": {
      "$ref": "#/$defs/ApiKey"
    },
    "token": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "token"
  ],
  "$defs": {
    "ApiKey": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "created": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "prefix",
        "created",
        "active"
      ]
    }
  }
}
