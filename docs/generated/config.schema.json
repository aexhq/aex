{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "agentloops": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "attachments": {
      "anyOf": [
        {
          "$ref": "#/$defs/Config"
        },
        {
          "type": "null"
        }
      ]
    },
    "billing": {
      "anyOf": [
        {
          "$ref": "#/$defs/Config2"
        },
        {
          "type": "null"
        }
      ]
    },
    "brain_url": {
      "type": "string"
    },
    "data_dir": {
      "type": "string"
    },
    "environments": {
      "anyOf": [
        {
          "$ref": "#/$defs/Config4"
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "listen": {
      "type": "string"
    },
    "operator_listen": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "listen",
    "operator_listen",
    "data_dir",
    "brain_url",
    "agentloops",
    "limits"
  ],
  "$defs": {
    "Config": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "bytes_per_account": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "count_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "public_origin": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "transfer_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ttl_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "public_origin",
        "bucket",
        "region",
        "max_bytes",
        "count_per_account",
        "bytes_per_account",
        "ttl_secs",
        "transfer_timeout_secs"
      ]
    },
    "Config2": {
      "type": "object",
      "properties": {
        "max_turn_secs": {
          "description": "Must bound the paired Brain server's maximum turn duration.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "payments": {
          "anyOf": [
            {
              "$ref": "#/$defs/Config3"
            },
            {
              "type": "null"
            }
          ]
        },
        "pricebook": {
          "$ref": "#/$defs/Pricebook"
        }
      },
      "additionalProperties": false,
      "required": [
        "pricebook",
        "max_turn_secs"
      ]
    },
    "Config3": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "return_url": {
          "type": "string"
        },
        "topup_amounts_cents": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "return_url",
        "topup_amounts_cents"
      ]
    },
    "Config4": {
      "type": "object",
      "properties": {
        "active_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "configuration": true,
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PublishedProfile"
          }
        },
        "public_url": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "public_url",
        "configuration",
        "active_per_account",
        "profiles"
      ]
    },
    "EnvironmentProfile": {
      "type": "object",
      "properties": {
        "maxLifetimeMs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": true,
      "required": [
        "maxLifetimeMs"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "active_turns_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "artifact_bytes_per_account": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "artifacts_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "claims_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hosts_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "keys_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minimum_free_disk_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "request_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "requests_per_account": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "response_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "retained_bytes_per_account": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "retention_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sessions_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "streams_per_account": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "turn_reserve_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "upstream_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_max_age_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "accounts",
        "keys_per_account",
        "sessions_per_account",
        "hosts_per_account",
        "claims_per_account",
        "active_turns_per_account",
        "streams_per_account",
        "requests",
        "requests_per_account",
        "request_bytes",
        "response_bytes",
        "upstream_timeout_secs",
        "retained_bytes_per_account",
        "turn_reserve_bytes",
        "minimum_free_disk_bytes",
        "retention_secs",
        "usage_max_age_secs",
        "artifacts_per_account",
        "artifact_bytes_per_account"
      ]
    },
    "Mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ]
    },
    "Pricebook": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "rates": {
          "type": "object",
          "properties": {
            "attachment_byte_secs": {
              "$ref": "#/$defs/Rate"
            },
            "egress_bytes": {
              "$ref": "#/$defs/Rate"
            },
            "sandbox_ms": {
              "$ref": "#/$defs/Rate"
            },
            "turn_ms": {
              "$ref": "#/$defs/Rate"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "rates"
      ]
    },
    "PublishedProfile": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "specification": {
          "$ref": "#/$defs/EnvironmentProfile"
        }
      },
      "additionalProperties": false,
      "required": [
        "accounts",
        "specification"
      ]
    },
    "Rate": {
      "description": "A rational price in micro-USD. Rating rounds once over cumulative resource usage.",
      "type": "object",
      "properties": {
        "micro_usd": {
          "type": "integer",
          "format": "int64"
        },
        "units": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "micro_usd",
        "units"
      ]
    }
  }
}
