{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentCatalog",
  "type": "object",
  "properties": {
    "driver_url": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EnvironmentProfile"
      }
    }
  },
  "required": [
    "driver_url",
    "profiles"
  ],
  "$defs": {
    "EnvironmentProfile": {
      "type": "object",
      "properties": {
        "maxLifetimeMs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": true,
      "required": [
        "maxLifetimeMs"
      ]
    }
  }
}
