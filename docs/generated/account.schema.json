{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Account",
  "type": "object",
  "properties": {
    "billing": {
      "$ref": "#/$defs/Billing"
    },
    "created": {
      "type": "integer",
      "format": "int64"
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "id",
    "created",
    "billing",
    "usage",
    "limits"
  ],
  "$defs": {
    "Billing": {
      "type": "string",
      "enum": [
        "preview_customer_model_keys",
        "prepaid_customer_model_keys"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "active_turns_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "artifact_bytes_per_account": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "artifacts_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "claims_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "hosts_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "keys_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minimum_free_disk_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "request_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "requests_per_account": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "response_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "retained_bytes_per_account": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "retention_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sessions_per_account": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "streams_per_account": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "turn_reserve_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "upstream_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "usage_max_age_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "accounts",
        "keys_per_account",
        "sessions_per_account",
        "hosts_per_account",
        "claims_per_account",
        "active_turns_per_account",
        "streams_per_account",
        "requests",
        "requests_per_account",
        "request_bytes",
        "response_bytes",
        "upstream_timeout_secs",
        "retained_bytes_per_account",
        "turn_reserve_bytes",
        "minimum_free_disk_bytes",
        "retention_secs",
        "usage_max_age_secs",
        "artifacts_per_account",
        "artifact_bytes_per_account"
      ]
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "charged_micro_usd": {
          "type": "integer",
          "format": "int64"
        },
        "pending_estimate_micro_usd": {
          "type": "integer",
          "format": "int64"
        },
        "rated_micro_usd": {
          "type": "integer",
          "format": "int64"
        },
        "reported_input_tokens": {
          "type": "integer",
          "format": "int64"
        },
        "reported_output_tokens": {
          "type": "integer",
          "format": "int64"
        },
        "unmeasured_calls": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "reported_input_tokens",
        "reported_output_tokens",
        "unmeasured_calls",
        "rated_micro_usd",
        "charged_micro_usd",
        "pending_estimate_micro_usd"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "active_turns": {
          "type": "integer",
          "format": "int64"
        },
        "attachment_bytes": {
          "type": "integer",
          "format": "int64"
        },
        "attachments": {
          "type": "integer",
          "format": "int64"
        },
        "measured_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "model": {
          "$ref": "#/$defs/TokenUsage"
        },
        "retained_bytes": {
          "type": "integer",
          "format": "int64"
        },
        "sessions": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "model",
        "sessions",
        "active_turns",
        "retained_bytes",
        "attachments",
        "attachment_bytes"
      ]
    }
  }
}
