{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attachment",
  "type": "object",
  "properties": {
    "expires_at": {
      "type": "integer",
      "format": "int64"
    },
    "id": {
      "type": "string"
    },
    "media": {
      "$ref": "#/$defs/AttachmentMedia"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "media",
    "expires_at"
  ],
  "$defs": {
    "AttachmentMedia": {
      "anyOf": [
        {
          "$ref": "#/$defs/Media"
        },
        {
          "$ref": "#/$defs/PdfMedia"
        }
      ]
    },
    "FileMediaType": {
      "type": "string",
      "enum": [
        "application/pdf"
      ]
    },
    "Media": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ]
    },
    "PdfMedia": {
      "type": "object",
      "properties": {
        "media_type": {
          "$ref": "#/$defs/FileMediaType"
        },
        "type": {
          "$ref": "#/$defs/PdfType"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "media_type",
        "url"
      ]
    },
    "PdfType": {
      "type": "string",
      "enum": [
        "file"
      ]
    }
  }
}
