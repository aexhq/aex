    {
      "schema": "aex.regional-table.v1",
      "table": "session-authority",
      "owner": "regional-stores",
      "purpose": "Session heads, text messages, native agents and journals, checkpoint/effect facts, frozen file mounts, encrypted session-scoped provider/MCP configuration, idempotency receipts, and restart-safe terminal deletion coordination.",
      "billingMode": "PAY_PER_REQUEST",
      "deletionProtection": true,
      "pointInTimeRecovery": {
        "enabled": true,
        "retentionDays": 35
      },
      "serverSideEncryption": {
        "type": "KMS",
        "keyAuthority": "regional-session",
        "rationale": "Per-authority customer managed key; content and secret authorities use different keys (R-SECRETS)."
      },
      "attributes": [
        {
          "name": "pk",
          "type": "S"
        },
        {
          "name": "sk",
          "type": "S"
        },
        {
          "name": "wsIndexPk",
          "type": "S"
        },
        {
          "name": "wsIndexSk",
          "type": "S"
        },
        {
          "name": "evPk",
          "type": "S"
        },
        {
          "name": "evSk",
          "type": "S"
        },
        {
          "name": "esPk",
          "type": "S"
        },
        {
          "name": "esSk",
          "type": "S"
        }
      ],
      "keySchema": {
        "partition": "pk",
        "sort": "sk"
      },
      "globalSecondaryIndexes": [
        {
          "name": "gsi_workspace_index",
          "partition": "wsIndexPk",
          "sort": "wsIndexSk",
          "sparse": true,
          "projectsRecordBody": false,
          "rationale": "Only public session heads and operation states carry the index attributes, so a list query can never surface a prompt, a journal entry or an idempotency receipt. KEYS_ONLY keeps this shared sparse index a cheap ordered locator: callers hydrate selected authority rows before filtering or returning them, which also prevents an eventually consistent index projection from becoming session or operation truth. Every live session head uses one lifecycle-neutral workspace partition ordered by createdAt and sessionId; irreversible deletion atomically replaces that payload-bearing head with an unindexed coordination envelope, so deleted content leaves the collection immediately.",
          "projection": {
            "type": "KEYS_ONLY",
            "attributes": []
          }
        },
        {
          "name": "gsi_workspace_events",
          "partition": "evPk",
          "sort": "evSk",
          "sparse": true,
          "projectsRecordBody": true,
          "rationale": "Only native events carry these attributes. Hour partitions prevent a hot unbounded workspace feed and the session and observation tie-breakers make cross-session ordering total. bodyInline is deliberately not projected: an inline body of up to 32 KiB would be stored again per event index, so readers hydrate the base row for an event that projects neither body attribute; bodyDigest stays projected because a digest is small and lets digest-bodied events serve without hydration.",
          "projection": {
            "type": "INCLUDE",
            "attributes": [
              "itemType",
              "workspaceId",
              "sessionId",
              "eventSeq",
              "eventId",
              "type",
              "runId",
              "agentId",
              "bodyDigest",
              "occurredAt",
              "outboxState"
            ]
          }
        },
        {
          "name": "gsi_session_events",
          "partition": "esPk",
          "sort": "esSk",
          "sparse": true,
          "projectsRecordBody": true,
          "rationale": "Only native events carry these attributes. Hour partitions and the canonical observation tuple provide exact event-time pagination for a session without scanning unrelated workspace traffic or changing the journal's sequence-ordered authority key. bodyInline is deliberately not projected, exactly as on gsi_workspace_events: readers hydrate the base row for an event that projects neither body attribute.",
          "projection": {
            "type": "INCLUDE",
            "attributes": [
              "itemType",
              "workspaceId",
              "sessionId",
              "eventSeq",
              "eventId",
              "type",
              "runId",
              "agentId",
              "bodyDigest",
              "occurredAt",
              "outboxState"
            ]
          }
        }
      ],
      "stream": {
        "enabled": true,
        "viewType": "KEYS_ONLY",
        "consumers": [
          "session-maintenance-worker"
        ],
        "rationale": "Maintenance receives identity-only hints and reloads the authority. Prompts and encrypted configuration are never duplicated into the stream."
      },
      "timeToLive": {
        "enabled": true,
        "attribute": "expiresAtEpochSeconds",
        "appliesTo": [
          "idempotency_receipt",
          "session_create_preparation",
          "session_create_prepared_file"
        ],
        "rationale": "Space reclamation only. Readers enforce receipt expiry; private create-election rows are immutable scaffolding and use TTL only after publication or compensation."
      },
      "itemTypes": [
        "session_head",
        "session_deletion_head",
        "session_tombstone",
        "session_deletion_progress",
        "session_deletion_evidence",
        "session_receipt_directory",
        "session_create_preparation",
        "session_create_prepared_file",
        "session_create_preparation_edge",
        "message",
        "sealed_message",
        "session_event",
        "agent_index",
