    {
      "schema": "aex.regional-table.v1",
      "table": "regional-registry",
      "owner": "regional-stores",
      "purpose": "The current (workspace, kind, name) registry pointer with its revision and ETag, multipart upload staging rows, and registry idempotency receipts.",
