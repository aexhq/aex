    {
      "schema": "aex.regional-table.v1",
      "table": "runtime-activity",
      "owner": "regional-stores",
      "purpose": "The exact Hands generation head, lifecycle intents and immutable receipts, true-idle probes, the current-generation pointer a Brain activation reads, and a sharded evaluation due index for the reaper.",
      "billingMode": "PAY_PER_REQUEST",
      "deletionProtection": true,
      "pointInTimeRecovery": {
        "enabled": true,
        "retentionDays": 35
      },
      "serverSideEncryption": {
        "type": "KMS",
        "keyAlias": "alias/aex-regional-runtime",
        "rationale": "Per-authority customer managed key. The table holds generation metadata only, never customer content."
      },
      "attributes": [
        {
          "name": "pk",
          "type": "S"
        },
        {
          "name": "sk",
          "type": "S"
        },
        {
          "name": "rtDuePk",
          "type": "S"
        },
        {
          "name": "rtDueSk",
          "type": "S"
        }
      ],
      "keySchema": {
        "partition": "pk",
        "sort": "sk"
      },
      "globalSecondaryIndexes": [
        {
          "name": "gsi_runtime_due",
          "partition": "rtDuePk",
          "sort": "rtDueSk",
          "sparse": true,
          "rationale": "Sixteen shards over non-terminal generation heads. A dedicated due index rather than a regional-work item per evaluation, because the 180 second true-idle timer would otherwise cost a work-item rewrite per generation per evaluation; the index gives the reaper a bounded ordered scan at zero write cost between evaluations.",
          "projection": {
            "type": "INCLUDE",
            "attributes": [
              "sessionId",
              "workspaceId",
              "generationId",
              "state",
              "fence",
              "idleSince",
              "providerLifetimeExpiresAt",
              "keepaliveLeaseUntil"
            ]
          }
        }
      ],
      "stream": {
        "enabled": true,
        "viewType": "NEW_IMAGE",
        "consumers": [
          "runtime-control-worker"
        ],
        "rationale": "The table holds no customer content, only generation metadata, so NEW_IMAGE is safe and gives the worker a state-change hint without a read."
      },
      "timeToLive": {
        "enabled": true,
        "attribute": "expiresAtEpochSeconds",
        "appliesTo": [
          "idle_probe"
        ],
        "rationale": "Probes only, at 7 days. Receipts have no TTL: they are lifecycle evidence referenced by usage facts."
      },
      "itemTypes": [
        "hands_generation",
        "lifecycle_intent",
        "lifecycle_receipt",
        "idle_probe",
        "current_generation"
      ],
      "iam": [
        {
          "role": "runtime-control-worker",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:UpdateItem",
            "dynamodb:TransactWriteItems"
          ],
          "resources": [
            "table",
            "index/*"
          ]
        },
        {
          "role": "brain-mux",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:UpdateItem",
            "dynamodb:TransactWriteItems"
          ],
          "resources": [
            "table"
          ]
        },
        {
          "role": "regional-session-api",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query"
          ],
          "resources": [
            "table"
          ]
        }
      ],
      "tags": {
        "aex:component": "runtime-activity",
        "aex:data-class": "authority",
        "aex:plane": "regional"
      }
    },
    {
      "schema": "aex.regional-table.v1",
      "table": "session-authority",
      "owner": "regional-stores",
      "purpose": "Session heads, messages, runs, native events, approvals, agent control and journals, durable operations and idempotency receipts. Brain session-level items live here under the BRAIN# sort-key prefix; per-agent items get their own partition.",
      "billingMode": "PAY_PER_REQUEST",
      "deletionProtection": true,
      "pointInTimeRecovery": {
        "enabled": true,
        "retentionDays": 35
      },
      "serverSideEncryption": {
        "type": "KMS",
        "keyAlias": "alias/aex-regional-session",
        "rationale": "Per-authority customer managed key; content and secret authorities use different keys (R-SECRETS)."
      },
      "attributes": [
        {
          "name": "pk",
          "type": "S"
        },
        {
          "name": "sk",
          "type": "S"
        },
        {
          "name": "wsIndexPk",
          "type": "S"
        },
        {
          "name": "wsIndexSk",
          "type": "S"
        }
      ],
      "keySchema": {
        "partition": "pk",
        "sort": "sk"
      },
      "globalSecondaryIndexes": [
        {
          "name": "gsi_workspace_index",
          "partition": "wsIndexPk",
          "sort": "wsIndexSk",
          "sparse": true,
          "rationale": "Only session heads and operation states carry the index attributes, so a list query can never surface a prompt, a journal entry or an idempotency receipt. lifecycle sits inside the index partition key so trash moves the item and purge removes it entirely, which makes ordinary list filter-free.",
          "projection": {
            "type": "INCLUDE",
            "attributes": [
              "sessionId",
              "operationId",
              "workspaceId",
              "status",
              "lifecycle",
              "kind",
              "createdAt",
              "updatedAt",
              "revision",
              "sessionRefId"
            ]
          }
        }
      ],
      "stream": {
        "enabled": true,
        "viewType": "KEYS_ONLY",
        "consumers": [
          "regional-stream"
        ],
        "rationale": "Least privilege: the stream consumer role learns pk and sk and nothing else. Replay and ordering are always Query by cursor; the stream is never truth."
      },
      "timeToLive": {
        "enabled": true,
        "attribute": "expiresAtEpochSeconds",
        "appliesTo": [
          "idempotency_receipt"
        ],
        "rationale": "Space reclamation only (OD-16, 24 hours). Every TTL'd row also carries an explicit expiresAt the reader checks; no fence reads TTL."
      },
      "itemTypes": [
        "session_head",
        "message",
        "run",
        "session_event",
        "approval",
        "agent_index",
        "agent_control",
        "journal_entry",
        "agent_effect",
        "fanout_page",
        "join_shard",
        "budget_return",
        "spend_reservation",
        "operation",
        "idempotency_receipt"
      ],
      "iam": [
        {
          "role": "regional-session-api",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:TransactWriteItems",
            "dynamodb:ConditionCheckItem",
            "dynamodb:UpdateItem",
            "dynamodb:PutItem"
          ],
          "resources": [
            "table",
            "index/*"
          ]
        },
        {
          "role": "session-operation-worker",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:TransactWriteItems",
            "dynamodb:UpdateItem",
            "dynamodb:PutItem",
            "dynamodb:DeleteItem"
          ],
          "resources": [
            "table",
            "index/*"
          ]
        },
        {
          "role": "brain-mux",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:TransactWriteItems",
            "dynamodb:UpdateItem",
            "dynamodb:PutItem"
          ],
          "resources": [
            "table"
          ]
        },
        {
          "role": "regional-observation-api",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query"
          ],
          "resources": [
            "table",
            "index/*"
          ]
        },
        {
          "role": "regional-stream",
          "actions": [
            "dynamodb:GetRecords",
            "dynamodb:GetShardIterator",
            "dynamodb:DescribeStream",
            "dynamodb:ListStreams"
          ],
          "resources": [
            "stream"
          ]
        }
      ],
      "tags": {
        "aex:component": "session",
        "aex:data-class": "authority",
        "aex:plane": "regional"
      }
    }
  ]
}
