    {
      "schema": "aex.regional-table.v1",
      "table": "regional-content",
      "owner": "regional-stores",
      "purpose": "Content body descriptors, inline ciphertext bodies, Merkle tree pages, root descriptors, root and body pins, download grants, GC epochs and GC candidates. Every partition is workspace scoped.",
      "billingMode": "PAY_PER_REQUEST",
      "deletionProtection": true,
      "pointInTimeRecovery": {
        "enabled": true,
        "retentionDays": 35
      },
      "serverSideEncryption": {
        "type": "KMS",
        "keyAlias": "alias/aex-regional-content",
        "rationale": "A dedicated content CMK, distinct from every other regional table (R-SECRETS). The key policy requires kms:EncryptionContext:aex:workspace to equal the caller workspace on Encrypt, Decrypt and GenerateDataKey (OD-18)."
      },
      "attributes": [
        {
          "name": "pk",
          "type": "S"
        },
        {
          "name": "sk",
          "type": "S"
        },
        {
          "name": "gcScanPk",
          "type": "S"
        },
        {
          "name": "gcScanSk",
          "type": "S"
        }
      ],
      "keySchema": {
        "partition": "pk",
        "sort": "sk"
      },
      "globalSecondaryIndexes": [
        {
          "name": "gsi_gc",
          "partition": "gcScanPk",
          "sort": "gcScanSk",
          "sparse": true,
          "rationale": "One index serves both mark (enumerate every body and page in 256 bounded buckets per workspace) and sweep (enumerate candidates). There is deliberately no reverse owner index and no reference count (R-DELETE): pin removal is a DeleteItem on a known key.",
          "projection": {
            "type": "INCLUDE",
            "attributes": [
              "workspaceId",
              "digestSha256",
              "pageDigest",
              "placement",
              "sizeBytes",
              "objectKey",
              "objectEtag",
              "gcEpoch",
              "notBefore",
              "state"
            ]
          }
        }
      ],
      "stream": {
        "enabled": true,
        "viewType": "KEYS_ONLY",
        "consumers": [
          "content-lifecycle-worker"
        ],
        "rationale": "KEYS_ONLY because the table holds ciphertext bodies; a NEW_IMAGE stream would duplicate every inline body into stream storage and into the pipe role blast radius. Storage usage facts ride regional-work transactionally instead."
      },
      "timeToLive": {
        "enabled": true,
        "attribute": "expiresAtEpochSeconds",
        "appliesTo": [
          "content_pin",
          "download_grant"
        ],
        "rationale": "Grant pins and grant state rows only, at expiry plus a 3600 second grace. GC never trusts it: GC re-reads expiresAt and refuses to delete a body whose grant pin has not provably expired."
      },
      "itemTypes": [
        "content_descriptor",
        "content_body",
        "content_pin",
        "download_grant",
        "root_descriptor",
        "tree_page",
        "gc_epoch",
        "gc_candidate"
      ],
      "iam": [
        {
          "role": "regional-session-api",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:TransactWriteItems",
            "dynamodb:ConditionCheckItem"
          ],
          "resources": [
            "table"
          ]
        },
        {
          "role": "content-lifecycle-worker",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:PutItem",
            "dynamodb:UpdateItem",
            "dynamodb:DeleteItem",
            "dynamodb:TransactWriteItems"
          ],
          "resources": [
            "table",
            "index/*"
          ]
        },
        {
          "role": "brain-mux",
          "actions": [
            "dynamodb:GetItem",
            "dynamodb:Query",
            "dynamodb:TransactWriteItems"
          ],
          "resources": [
            "table"
          ]
        },
        {
          "role": "session-operation-worker",
          "actions": [
            "dynamodb:GetItem",
