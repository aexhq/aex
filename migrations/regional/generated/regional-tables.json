            "dynamodb:UpdateItem",
            "dynamodb:TransactWriteItems"
          ],
          "resources": [
            "table",
            "index/*"
          ]
        },
        {
          "role": "brain-mux",
          "actions": [
            "dynamodb:TransactWriteItems",
            "dynamodb:GetItem"
          ],
          "resources": [
            "table"
          ]
        },
        {
          "role": "regional-stream",
