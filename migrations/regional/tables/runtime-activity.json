{
  "schema": "aex.regional-table.v1",
  "table": "runtime-activity",
  "owner": "regional-stores",
  "purpose": "The exact Hands generation head, idempotent open-operation admission markers, lifecycle intents and immutable receipts, transactional usage outbox, true-idle probes, the current-generation pointer a Brain activation reads, and a sharded evaluation due index for the reaper.",
  "billingMode": "PAY_PER_REQUEST",
  "deletionProtection": true,
  "pointInTimeRecovery": { "enabled": true, "retentionDays": 35 },
  "serverSideEncryption": {
    "type": "KMS",
    "keyAuthority": "regional-runtime",
    "rationale": "Per-authority customer managed key. The table holds generation metadata only, never customer content."
  },
  "attributes": [
    { "name": "pk", "type": "S" },
    { "name": "sk", "type": "S" },
    { "name": "rtDuePk", "type": "S" },
    { "name": "rtDueSk", "type": "S" }
  ],
  "keySchema": { "partition": "pk", "sort": "sk" },
  "globalSecondaryIndexes": [
    {
      "name": "gsi_runtime_due",
      "partition": "rtDuePk",
      "sort": "rtDueSk",
      "sparse": true,
      "projectsRecordBody": false,
      "rationale": "Sixteen shards over generation heads and undelivered usage outbox rows. A dedicated due index avoids one work-item rewrite per generation per evaluation and keeps receipt delivery retryable after a terminal head leaves the index.",
      "projection": {
        "type": "INCLUDE",
        "attributes": [
          "sessionId",
          "workspaceId",
          "generationId",
          "state",
          "fence",
          "revision",
          "idleSince",
          "providerLifetimeExpiresAt",
          "keepaliveLeaseUntil"
        ]
      }
    }
  ],
  "stream": {
    "enabled": true,
    "viewType": "NEW_IMAGE",
    "consumers": ["runtime-control-worker"],
    "rationale": "The table holds no customer content, only generation metadata, so NEW_IMAGE is safe and gives the worker a state-change hint without a read."
  },
  "timeToLive": {
    "enabled": true,
    "attribute": "expiresAtEpochSeconds",
    "appliesTo": ["idle_probe"],
    "rationale": "Probes only, at 7 days. Receipts have no TTL: they are lifecycle evidence referenced by usage facts."
  },
  "itemTypes": [
    "hands_generation",
    "lifecycle_intent",
    "lifecycle_receipt",
    "idle_probe",
    "current_generation",
    "usage_outbox",
    "hands_operation_admission"
  ],
  "iam": [
    {
      "role": "runtime-control-worker",
      "actions": [
        "dynamodb:GetItem",
        "dynamodb:DescribeTable",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:TransactWriteItems"
      ],
      "resources": ["table", "index/*"]
    },
    {
      "role": "brain-mux",
      "actions": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:TransactWriteItems"
      ],
      "resources": ["table"]
    },
    {
      "role": "regional-session-api",
      "actions": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:TransactWriteItems"
      ],
      "resources": ["table"]
    },
    {
      "role": "session-operation-worker",
      "actions": ["dynamodb:GetItem"],
      "resources": ["table"]
    }
  ],
  "tags": { "aex:plane": "regional", "aex:component": "runtime-activity", "aex:data-class": "authority" }
}
