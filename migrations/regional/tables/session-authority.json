{
  "schema": "aex.regional-table.v1",
  "table": "session-authority",
  "owner": "regional-stores",
  "purpose": "Session heads, messages, runs, native events, approvals, agent control and journals, durable operations, idempotency receipts, and the fenced empty-workspace control row. Brain session-level items live here under the BRAIN# sort-key prefix; per-agent items get their own partition.",
  "billingMode": "PAY_PER_REQUEST",
  "deletionProtection": true,
  "pointInTimeRecovery": { "enabled": true, "retentionDays": 35 },
  "serverSideEncryption": {
    "type": "KMS",
    "keyAuthority": "regional-session",
    "rationale": "Per-authority customer managed key; content and secret authorities use different keys (R-SECRETS)."
  },
  "attributes": [
    { "name": "pk", "type": "S" },
    { "name": "sk", "type": "S" },
    { "name": "wsIndexPk", "type": "S" },
    { "name": "wsIndexSk", "type": "S" },
    { "name": "evPk", "type": "S" },
    { "name": "evSk", "type": "S" },
    { "name": "esPk", "type": "S" },
    { "name": "esSk", "type": "S" }
  ],
  "keySchema": { "partition": "pk", "sort": "sk" },
  "globalSecondaryIndexes": [
    {
      "name": "gsi_workspace_index",
      "partition": "wsIndexPk",
      "sort": "wsIndexSk",
      "sparse": true,
      "projectsRecordBody": false,
      "rationale": "Only session heads and operation states carry the index attributes, so a list query can never surface a prompt, a journal entry or an idempotency receipt. KEYS_ONLY keeps this shared sparse index a cheap ordered locator: callers hydrate selected authority rows before filtering or returning them, which also prevents an eventually consistent index projection from becoming session or operation truth. Every live, trashed and purging session head uses one lifecycle-neutral workspace partition ordered by createdAt and sessionId; this gives the public collection one total order and lets strong hydration apply exact status filtering. Purge completion removes the sparse keys entirely.",
      "projection": { "type": "KEYS_ONLY", "attributes": [] }
    },
    {
      "name": "gsi_workspace_events",
      "partition": "evPk",
      "sort": "evSk",
      "sparse": true,
      "projectsRecordBody": true,
      "rationale": "Only native events carry these attributes. Hour partitions prevent a hot unbounded workspace feed and the session and observation tie-breakers make cross-session ordering total. bodyInline is deliberately not projected: an inline body of up to 32 KiB would be stored again per event index, so readers hydrate the base row for an event that projects neither body attribute; bodyDigest stays projected because a digest is small and lets digest-bodied events serve without hydration.",
      "projection": {
        "type": "INCLUDE",
        "attributes": [
          "itemType",
          "workspaceId",
          "sessionId",
          "eventSeq",
          "eventId",
          "type",
          "runId",
          "agentId",
          "bodyDigest",
          "occurredAt",
          "outboxState"
        ]
      }
    },
    {
      "name": "gsi_session_events",
      "partition": "esPk",
      "sort": "esSk",
      "sparse": true,
      "projectsRecordBody": true,
      "rationale": "Only native events carry these attributes. Hour partitions and the canonical observation tuple provide exact event-time pagination for a session without scanning unrelated workspace traffic or changing the journal's sequence-ordered authority key. bodyInline is deliberately not projected, exactly as on gsi_workspace_events: readers hydrate the base row for an event that projects neither body attribute.",
      "projection": {
        "type": "INCLUDE",
        "attributes": [
          "itemType",
          "workspaceId",
          "sessionId",
          "eventSeq",
          "eventId",
          "type",
          "runId",
          "agentId",
          "bodyDigest",
          "occurredAt",
          "outboxState"
        ]
      }
    }
  ],
  "stream": {
    "enabled": true,
    "viewType": "KEYS_ONLY",
    "consumers": ["regional-stream"],
    "rationale": "Least privilege: the stream consumer role learns pk and sk and nothing else. Replay and ordering are always Query by cursor; the stream is never truth."
  },
  "timeToLive": {
    "enabled": true,
    "attribute": "expiresAtEpochSeconds",
    "appliesTo": ["idempotency_receipt", "session_create_preparation", "session_create_prepared_file"],
    "rationale": "Space reclamation only (OD-16, 24 hours). Public receipts carry an explicit expiresAt checked by readers; private create-election rows are immutable scaffolding and use TTL only for eventual cleanup after publication or compensation. No authority fence reads TTL."
  },
  "itemTypes": [
    "session_head",
    "session_create_preparation",
    "session_create_prepared_file",
    "message",
    "sealed_message",
    "run",
    "session_event",
    "approval",
    "agent_index",
    "agent_control",
    "journal_entry",
    "agent_effect",
    "fanout_page",
    "join_shard",
    "budget_return",
    "operation",
    "idempotency_receipt",
    "outbox_event",
    "regional_workspace_control"
  ],
  "iam": [
    {
      "role": "regional-control",
      "actions": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "resources": ["table"]
    },
    {
      "role": "regional-session-api",
      "actions": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:TransactWriteItems",
        "dynamodb:UpdateItem",
        "dynamodb:PutItem"
      ],
      "resources": ["table", "index/*"]
    },
    {
      "role": "session-operation-worker",
      "actions": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:TransactWriteItems",
        "dynamodb:UpdateItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "resources": ["table", "index/*"]
    },
    {
      "role": "brain-mux",
      "actions": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:TransactWriteItems",
        "dynamodb:UpdateItem",
        "dynamodb:PutItem"
      ],
      "resources": ["table"]
    },
    {
      "role": "runtime-control-worker",
      "actions": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:DescribeTable"
      ],
      "resources": ["table"]
    },
    {
      "role": "regional-observation-api",
      "actions": [
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query"
      ],
      "resources": ["table", "index/*"]
    },
    {
      "role": "regional-observation-api",
      "actions": ["dynamodb:TransactGetItems"],
      "resources": ["table"],
      "itemTypes": ["operation"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["EXPORT#*", "OP#*"]
      }
    },
    {
      "role": "regional-observation-api",
      "actions": ["dynamodb:TransactWriteItems"],
      "resources": ["table"],
      "itemTypes": ["operation"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["EXPORT#*", "FRONT#*", "OP#*", "SESSION#*"]
      }
    },
    {
      "role": "observation-export-task",
      "actions": ["dynamodb:DescribeTable", "dynamodb:GetItem"],
      "resources": ["table"]
    },
    {
      "role": "observation-export-task",
      "actions": ["dynamodb:TransactGetItems"],
      "resources": ["table"],
      "itemTypes": ["operation"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["EXPORT#*", "OP#*"]
      }
    },
    {
      "role": "observation-export-task",
      "actions": ["dynamodb:TransactWriteItems"],
      "resources": ["table"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["EXPORT#*", "FRONT#*", "OP#*", "SESSION#*"]
      }
    },
    {
      "role": "observation-reconciler",
      "actions": ["dynamodb:TransactGetItems"],
      "resources": ["table"],
      "itemTypes": ["operation"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["EXPORT#*", "OP#*"]
      }
    },
    {
      "role": "observation-reconciler",
      "actions": ["dynamodb:TransactWriteItems"],
      "resources": ["table"],
      "itemTypes": ["operation"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["EXPORT#*", "FRONT#*", "OP#*", "SESSION#*"]
      }
    },
    {
      "role": "regional-stream",
      "actions": [
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query"
      ],
      "resources": ["table", "index/*"]
    },
    {
      "role": "regional-stream",
      "actions": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:DescribeStream"
      ],
      "resources": ["stream"]
    }
  ],
  "tags": { "aex:plane": "regional", "aex:component": "session", "aex:data-class": "authority" }
}
