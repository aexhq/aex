{
  "schema": "aex.regional-table.v1",
  "table": "regional-secret-custody",
  "owner": "regional-stores",
  "purpose": "Workspace secret metadata, hidden source generations carrying ciphertext, session custody heads and bindings, the revocation epoch, managed-call authorizations, the provider-credential binding directory for BYOK, and the per-session redaction digest manifest.",
  "billingMode": "PAY_PER_REQUEST",
  "deletionProtection": true,
  "pointInTimeRecovery": { "enabled": true, "retentionDays": 35 },
  "serverSideEncryption": {
    "type": "KMS",
    "keyAuthority": "regional-secret",
    "rationale": "A dedicated secret CMK, distinct from content and from every other table (R-SECRETS). Application-layer AEAD is the real protection; SSE is defence in depth."
  },
  "attributes": [
    { "name": "pk", "type": "S" },
    { "name": "sk", "type": "S" }
  ],
  "keySchema": { "partition": "pk", "sort": "sk" },
  "globalSecondaryIndexes": [],
  "stream": {
    "enabled": false,
    "viewType": "NONE",
    "consumers": [],
    "rationale": "Disabled deliberately: no consumer role should ever be able to read secret ciphertext off a change feed, and there is no legitimate regional consumer."
  },
  "timeToLive": {
    "enabled": false,
    "attribute": "",
    "appliesTo": [],
    "rationale": "Deletion is explicit, so TTL would only create a silent erasure path for secret material."
  },
  "itemTypes": [
    "workspace_secret",
    "secret_lineage",
    "secret_source_generation",
    "session_custody",
    "custody_binding",
    "managed_call",
    "call_authorization",
    "rebind_intent",
    "redaction_manifest",
    "provider_credential",
    "idempotency_receipt"
  ],
  "iam": [
    {
      "role": "regional-secret-api",
      "actions": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:TransactWriteItems",
        "dynamodb:ConditionCheckItem"
      ],
      "resources": ["table"]
    },
    {
      "role": "regional-session-api",
      "actions": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:TransactWriteItems"],
      "resources": ["table"]
    },
    {
      "role": "brain-mux",
      "actions": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:TransactWriteItems"],
      "resources": ["table"]
    },
    {
      "role": "regional-otlp",
      "actions": ["dynamodb:GetItem"],
      "resources": ["table"]
    }
  ],
  "tags": { "aex:plane": "regional", "aex:component": "secret-custody", "aex:data-class": "secret" }
}
