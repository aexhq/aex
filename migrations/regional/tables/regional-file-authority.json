{
  "schema": "aex.regional-table.v1",
  "table": "regional-file-authority",
  "owner": "regional-stores",
  "purpose": "Latest-only logical workspace files, overwrite intents, upload staging and receipts, immutable content descriptors and session pins. One table makes pointer publication and file lifecycle one authority; prior objects remain private retention details rather than public versions.",
  "billingMode": "PAY_PER_REQUEST",
  "deletionProtection": true,
  "pointInTimeRecovery": { "enabled": true, "retentionDays": 35 },
  "serverSideEncryption": {
    "type": "KMS",
    "keyAuthority": "regional-file",
    "rationale": "A dedicated file key separates customer bytes and file metadata from session execution state."
  },
  "attributes": [
    { "name": "pk", "type": "S" },
    { "name": "sk", "type": "S" },
    { "name": "gcScanPk", "type": "S" },
    { "name": "gcScanSk", "type": "S" },
    { "name": "expiryShardPk", "type": "S" },
    { "name": "expiryShardSk", "type": "S" }
  ],
  "keySchema": { "partition": "pk", "sort": "sk" },
  "globalSecondaryIndexes": [
    {
      "name": "gsi_gc",
      "partition": "gcScanPk",
      "sort": "gcScanSk",
      "sparse": true,
      "projectsRecordBody": false,
      "rationale": "Only unreferenced immutable objects enter the bounded cleanup index; current pointers and session pins never do.",
      "projection": { "type": "INCLUDE", "attributes": ["workspaceId", "digestSha256", "objectKey", "sizeBytes", "notBefore", "state"] }
    },
    {
      "name": "gsi_expiry",
      "partition": "expiryShardPk",
      "sort": "expiryShardSk",
      "sparse": true,
      "projectsRecordBody": false,
      "rationale": "Expired grants and abandoned uploads are reclaimed in bounded due pages; TTL is not the cleanup authority.",
      "projection": { "type": "INCLUDE", "attributes": ["workspaceId", "uploadId", "contentDigest", "expiresAt"] }
    }
  ],
  "stream": {
    "enabled": true,
    "viewType": "NEW_IMAGE",
    "consumers": ["file-ingest-worker"],
    "rationale": "The worker needs the current fenced URL/upload intent. Payload bytes stay in S3; stream images contain bounded metadata only."
  },
  "timeToLive": {
    "enabled": true,
    "attribute": "expiresAtEpochSeconds",
    "appliesTo": ["idempotency_receipt", "download_grant"],
    "rationale": "Receipts and expired grants only. Pending imports, uploads, pointers, descriptors and session pins require explicit fenced cleanup."
  },
  "itemTypes": [
    "file_pointer", "file_intent", "content_descriptor", "content_pin",
    "upload", "upload_parts", "download_grant", "idempotency_receipt", "gc_candidate"
  ],
  "iam": [
    {
      "role": "session-api",
      "actions": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:TransactWriteItems"],
      "resources": ["table", "index/*"]
    },
    {
      "role": "file-ingest-worker",
      "actions": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:TransactWriteItems", "dynamodb:GetRecords", "dynamodb:GetShardIterator", "dynamodb:DescribeStream", "dynamodb:ListStreams"],
      "resources": ["table", "index/*", "stream"]
    },
    {
      "role": "tool-mux",
      "actions": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:TransactWriteItems"],
      "resources": ["table"]
    },
    {
      "role": "session-maintenance-worker",
      "actions": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:TransactWriteItems"],
      "resources": ["table", "index/*"]
    }
  ],
  "tags": { "aex:plane": "regional", "aex:component": "file", "aex:data-class": "authority" }
}
