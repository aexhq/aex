{
  "schema": "aex.regional-table.v1",
  "table": "regional-authz-projection",
  "owner": "regional-stores",
  "purpose": "Read-only launch-region projection of the personal workspace placement, API-key authorization and central projection frontier.",
  "billingMode": "PAY_PER_REQUEST",
  "deletionProtection": true,
  "pointInTimeRecovery": { "enabled": true, "retentionDays": 35 },
  "serverSideEncryption": {
    "type": "KMS",
    "keyAuthority": "regional-authz",
    "rationale": "The projection carries authorization epochs and placement, never credentials or customer content."
  },
  "attributes": [{ "name": "pk", "type": "S" }, { "name": "sk", "type": "S" }],
  "keySchema": { "partition": "pk", "sort": "sk" },
  "globalSecondaryIndexes": [],
  "stream": { "enabled": false, "viewType": "NONE", "consumers": [], "rationale": "Request admission reads exact keys; there is no regional projection writer behind this table." },
  "timeToLive": { "enabled": false, "attribute": "", "appliesTo": [], "rationale": "Authorization and placement disappear only through explicit central revocation/deletion projection." },
  "itemTypes": ["workspace_placement", "key_authorization", "feed_frontier"],
  "iam": [
    {
      "role": "control-projection-worker",
      "actions": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "resources": ["table"],
      "condition": { "operator": "ForAllValues:StringLike", "key": "dynamodb:LeadingKeys", "values": ["WS#*", "KEY#*", "FEED"] }
    },
    {
      "role": "session-api",
      "actions": ["dynamodb:GetItem", "dynamodb:TransactGetItems", "dynamodb:Query"],
      "resources": ["table"]
    }
  ],
  "tags": { "aex:plane": "regional", "aex:component": "authz-projection", "aex:data-class": "projection" }
}
