{
  "schema": "aex.regional-table.v1",
  "table": "regional-authz-projection",
  "owner": "regional-stores",
  "purpose": "Read-only regional projection of workspace placement, descriptive profiles, effective limits, API key revocation and the signed feed frontier. Central control owns placement, profile, revocation and frontier rows; regional capacity alone owns effective-limit rows. Partition-key-scoped IAM keeps those write capabilities disjoint, while every serving regional role holds GetItem and Query only.",
  "billingMode": "PAY_PER_REQUEST",
  "deletionProtection": true,
  "pointInTimeRecovery": { "enabled": true, "retentionDays": 35 },
  "serverSideEncryption": {
    "type": "KMS",
    "keyAuthority": "regional-authz",
    "rationale": "Per-authority customer managed key. The projection carries authorization epochs, not credentials."
  },
  "attributes": [
    { "name": "pk", "type": "S" },
    { "name": "sk", "type": "S" }
  ],
  "keySchema": { "partition": "pk", "sort": "sk" },
  "globalSecondaryIndexes": [],
  "stream": {
    "enabled": false,
    "viewType": "NONE",
    "consumers": [],
    "rationale": "The projection is a read replica of central control state; regional consumers read it by key, never by change feed."
  },
  "timeToLive": {
    "enabled": false,
    "attribute": "",
    "appliesTo": [],
    "rationale": "A revocation row that silently disappeared would fail open, which is the one direction this table must never fail."
  },
  "itemTypes": ["workspace_placement", "workspace_profile", "workspace_limit", "key_revocation", "feed_frontier"],
  "iam": [
    {
      "role": "central-control-worker",
      "actions": ["dynamodb:GetItem"],
      "resources": ["table"]
    },
    {
      "role": "central-control-worker",
      "actions": ["dynamodb:PutItem"],
      "resources": ["table"],
      "itemTypes": ["workspace_placement", "workspace_profile", "key_revocation", "feed_frontier"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["WS#*", "KEY#*", "FEED"]
      }
    },
    {
      "role": "regional-capacity-controller",
      "actions": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "resources": ["table"],
      "itemTypes": ["workspace_limit"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["LIMIT#*"]
      }
    },
    {
      "role": "regional-session-api",
      "actions": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:ConditionCheckItem"],
      "resources": ["table"]
    },
    {
      "role": "regional-secret-api",
      "actions": ["dynamodb:GetItem", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "regional-observation-api",
      "actions": ["dynamodb:GetItem", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "regional-stream",
      "actions": ["dynamodb:GetItem", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "regional-otlp",
      "actions": ["dynamodb:GetItem", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "brain-mux",
      "actions": ["dynamodb:GetItem", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "session-operation-worker",
      "actions": ["dynamodb:GetItem", "dynamodb:Query"],
      "resources": ["table"]
    }
  ],
  "tags": { "aex:plane": "regional", "aex:component": "authz-projection", "aex:data-class": "projection" }
}
