{
  "schema": "aex.regional-table.v1",
  "table": "regional-authz-projection",
  "owner": "regional-stores",
  "purpose": "Read-only regional projection of workspace placement, descriptive profiles, effective limits, API key authorization and the signed feed frontier. Central control owns placement, profile, key authorization and frontier rows; regional capacity alone owns effective-limit rows, including the hot admission subset a request edge reads. Partition-key-scoped IAM keeps those write capabilities disjoint, while every serving regional role reads only: GetItem, Query, and TransactGetItems for the one-request admission snapshot.",
  "billingMode": "PAY_PER_REQUEST",
  "deletionProtection": true,
  "pointInTimeRecovery": { "enabled": true, "retentionDays": 35 },
  "serverSideEncryption": {
    "type": "KMS",
    "keyAuthority": "regional-authz",
    "rationale": "Per-authority customer managed key. The projection carries authorization epochs, not credentials."
  },
  "attributes": [
    { "name": "pk", "type": "S" },
    { "name": "sk", "type": "S" }
  ],
  "keySchema": { "partition": "pk", "sort": "sk" },
  "globalSecondaryIndexes": [],
  "stream": {
    "enabled": false,
    "viewType": "NONE",
    "consumers": [],
    "rationale": "The projection is a read replica of central control state; regional consumers read it by key, never by change feed."
  },
  "timeToLive": {
    "enabled": false,
    "attribute": "",
    "appliesTo": [],
    "rationale": "A key authorization row that silently disappeared would take a live key with it, and an expired one would be indistinguishable from a forged key id. Neither direction is acceptable, so nothing here expires."
  },
  "itemTypes": ["workspace_placement", "workspace_profile", "workspace_limit", "workspace_limit_bundle_head", "workspace_limit_bundle", "workspace_edge_limits", "key_authorization", "feed_frontier"],
  "iam": [
    {
      "role": "central-control-worker",
      "actions": ["dynamodb:GetItem"],
      "resources": ["table"]
    },
    {
      "role": "central-control-worker",
      "actions": ["dynamodb:PutItem"],
      "resources": ["table"],
      "itemTypes": ["workspace_placement", "workspace_profile", "key_authorization", "feed_frontier"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["WS#*", "KEY#*", "FEED"]
      }
    },
    {
      "role": "regional-capacity-controller",
      "actions": ["dynamodb:PutItem"],
      "resources": ["table"],
      "itemTypes": ["workspace_limit", "workspace_limit_bundle_head", "workspace_limit_bundle", "workspace_edge_limits"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["LIMIT#*"]
      }
    },
    {
      "role": "regional-control",
      "actions": ["dynamodb:GetItem", "dynamodb:TransactWriteItems"],
      "resources": ["table"],
      "itemTypes": ["workspace_placement"],
      "condition": {
        "operator": "ForAllValues:StringLike",
        "key": "dynamodb:LeadingKeys",
        "values": ["WS#*"]
      }
    },
    {
      "role": "regional-session-api",
      "actions": ["dynamodb:GetItem", "dynamodb:TransactGetItems", "dynamodb:TransactWriteItems", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "regional-secret-api",
      "actions": ["dynamodb:GetItem", "dynamodb:TransactGetItems", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "regional-observation-api",
      "actions": ["dynamodb:GetItem", "dynamodb:TransactGetItems", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "regional-stream",
      "actions": ["dynamodb:GetItem", "dynamodb:TransactGetItems", "dynamodb:Query"],
      "resources": ["table"]
    },
    {
      "role": "regional-otlp",
      "actions": ["dynamodb:GetItem", "dynamodb:TransactGetItems", "dynamodb:Query"],
      "resources": ["table"]
    }
  ],
  "tags": { "aex:plane": "regional", "aex:component": "authz-projection", "aex:data-class": "projection" }
}
