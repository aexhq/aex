{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aex.dev/schemas/regional-table.v1.json",
  "title": "aex.regional-table.v1",
  "description": "One regional DynamoDB table generation definition. Terraform consumes the generated bundle, never a hand-written table resource.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "table",
    "owner",
    "purpose",
    "billingMode",
    "deletionProtection",
    "pointInTimeRecovery",
    "serverSideEncryption",
    "attributes",
    "keySchema",
    "globalSecondaryIndexes",
    "stream",
    "timeToLive",
    "itemTypes",
    "iam",
    "tags"
  ],
  "properties": {
    "schema": { "const": "aex.regional-table.v1" },
    "table": {
      "description": "Logical table name. The physical name is `{plane}-{region}-{table}` and is composed by the infrastructure stream.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "owner": { "enum": ["regional-stores", "observations-usage"] },
    "purpose": { "type": "string", "minLength": 16 },
    "billingMode": { "const": "PAY_PER_REQUEST" },
    "deletionProtection": { "const": true },
    "pointInTimeRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "retentionDays"],
      "properties": {
        "enabled": { "const": true },
        "retentionDays": { "const": 35 }
      }
    },
    "physicalNamePinned": {
      "description": "Set on a table whose physical name may not be derived from the environment prefix because the name itself is bound to the data — the hierarchical keyring's branch-key store is the only such table. The name is an environment decision and lives in the environment binding, never here: a physical name in this bundle could not be qualified by plane, and two planes share one account. The flag is what tells the environment root that a derived name would be wrong.",
      "const": true
    },
    "serverSideEncryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "keyAuthority", "rationale"],
      "properties": {
        "type": { "const": "KMS" },
        "keyAuthority": {
          "description": "The authority whose customer managed key encrypts this table. It is an authority id, never a physical alias: two planes share one account, so the physical alias is `alias/aex-{plane}-{region}-{authority}` and is composed by the environment root.",
          "type": "string",
          "pattern": "^regional-[a-z][a-z0-9-]*$"
        },
        "rationale": { "type": "string", "minLength": 8 }
      }
    },
    "attributes": {
      "description": "Only key and index attributes are declared; DynamoDB is schemaless for everything else.",
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "type": { "enum": ["S", "N", "B"] }
        }
      }
    },
    "keySchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition", "sort"],
      "properties": {
        "partition": { "type": "string" },
        "sort": { "type": "string" }
      }
    },
    "globalSecondaryIndexes": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "partition",
          "sort",
          "projection",
          "sparse",
          "projectsRecordBody",
          "rationale"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^gsi_[a-z_]+$" },
          "partition": { "type": "string" },
          "sort": { "type": "string" },
          "sparse": { "const": true },
          "projectsRecordBody": {
            "description": "Whether this index deliberately projects the record body. A body-shaped attribute may appear in a projection only where this is true, and `rationale` must then say why a query over this index is allowed to return it. It is true for exactly the observation indexes, whose rows are the record the query returns; it is false everywhere a list must not be able to surface a prompt, a body or a receipt (D-29).",
            "type": "boolean"
          },
          "rationale": { "type": "string", "minLength": 8 },
          "projection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "attributes"],
            "properties": {
              "type": {
                "description": "ALL is never permitted: D-29. A list query must not be able to start returning a prompt, a body or a receipt. KEYS_ONLY carries the index and base key attributes and nothing else, and is the least a sparse index can project.",
                "enum": ["INCLUDE", "KEYS_ONLY"]
              },
              "attributes": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "type": { "const": "INCLUDE" } } },
                "then": { "properties": { "attributes": { "minItems": 1 } } }
              },
              {
                "if": { "properties": { "type": { "const": "KEYS_ONLY" } } },
                "then": { "properties": { "attributes": { "maxItems": 0 } } }
              }
            ]
          }
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "viewType", "consumers", "rationale"],
      "properties": {
        "enabled": { "type": "boolean" },
        "viewType": { "enum": ["KEYS_ONLY", "NEW_IMAGE", "NONE"] },
        "consumers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rationale": { "type": "string", "minLength": 8 }
      }
    },
    "timeToLive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "attribute", "appliesTo", "rationale"],
      "properties": {
        "enabled": { "type": "boolean" },
        "attribute": {
          "description": "Always `expiresAtEpochSeconds` when enabled, and never a fence: D-24.",
          "enum": ["expiresAtEpochSeconds", ""]
        },
        "appliesTo": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rationale": { "type": "string", "minLength": 8 }
      }
    },
    "itemTypes": {
      "description": "The closed `itemType` discriminator vocabulary. Decoding an unlisted value is StoreError::Corrupt.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$|^branch_key_record$" }
    },
    "iam": {
      "description": "Least-privilege action lists per role, emitted so the infrastructure stream generates policies mechanically.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "actions", "resources"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "dynamodb:GetItem",
                "dynamodb:BatchGetItem",
                "dynamodb:Query",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:BatchWriteItem",
                "dynamodb:TransactWriteItems",
                "dynamodb:TransactGetItems",
                "dynamodb:ConditionCheckItem",
                "dynamodb:DescribeTable",
                "dynamodb:GetRecords",
                "dynamodb:GetShardIterator",
                "dynamodb:DescribeStream",
                "dynamodb:ListStreams"
              ]
            }
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["table", "index/*", "stream"] }
          },
          "itemTypes": {
            "description": "The disjoint item families this write capability owns. Read-only grants omit it. DynamoDB IAM enforcement remains on the corresponding partition-key family through condition.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$|^branch_key_record$" }
          },
          "condition": {
            "description": "An optional request-shape restriction carried mechanically into the generated role statement.",
            "type": "object",
            "additionalProperties": false,
            "required": ["operator", "key", "values"],
            "properties": {
              "operator": { "enum": ["ForAllValues:StringLike"] },
              "key": { "enum": ["dynamodb:LeadingKeys"] },
              "values": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^([A-Z][A-Z0-9_]*#\\*|[A-Z][A-Z0-9_]*)$" }
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aex:plane", "aex:component", "aex:data-class"],
      "properties": {
        "aex:plane": { "const": "regional" },
        "aex:component": { "type": "string", "minLength": 1 },
        "aex:data-class": { "enum": ["authority", "secret", "projection"] }
      }
    }
  }
}
