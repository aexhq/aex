{
  "schemaVersion": 1,
  "publicDocs": [
    "README.md",
    "SECURITY.md",
    "packages/sdk/README.md",
    "packages/sdk/docs"
  ],
  "publicSourceRoots": [
    "packages/contracts/src",
    "packages/sdk/src",
    "packages/cli/src",
    "packages/conformance/src"
  ],
  "temporaryAllowedPublicImports": [
    "@aexhq/contracts",
    "@aexhq/contracts/internal"
  ],
  "sdkPackage": {
    "dir": "packages/sdk",
    "name": "@aexhq/sdk",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "bin": {
      "aex": "./dist/cli.mjs"
    },
    "allowedRuntimeDependencies": [
      "fflate",
      "ignore"
    ],
    "allowedPackedPathPrefixes": [
      "package.json",
      "README.md",
      "docs/",
      "dist/"
    ],
    "forbiddenPackedPathPatterns": [
      "(^|/)\\.env(?:\\.|$)",
      "^(?:\\.github|apps|eval|scripts|tools)(?:/|$)",
      "^(?:packages/(?:cli|db|runtime-bridge|shared|conformance))(?:/|$)",
      "(^|/)vercel\\.json$"
    ]
  },
  "contractsInline": {
    "sourcePackage": "@aexhq/contracts",
    "sdkPackedPrefix": "dist/_contracts/",
    "allowedModuleFiles": [
      "./api-key.js",
      "./archive-limits.js",
      "./asset-authoring.js",
      "./asset-bundle.js",
      "./asset-upload-helper.js",
      "./bundle-manifest.js",
      "./canonical-sha256.js",
      "./connection-ticket.js",
      "./error-codes.js",
      "./error-factory.js",
      "./event-envelope.js",
      "./event-stream-client.js",
      "./event-view.js",
      "./http.js",
      "./index.js",
      "./internal.js",
      "./runtime-kind.js",
      "./runtime-sizes.js",
      "./models.js",
      "./operations.js",
      "./post-hook.js",
      "./provider-support.js",
      "./session-artifacts.js",
      "./session-cost.js",
      "./session-custody.js",
      "./session-record.js",
      "./session-retention.js",
      "./turn-trace.js",
      "./session-config.js",
      "./runner-event.js",
      "./runtime-manifest.js",
      "./runtime-security-profile.js",
      "./runtime-types.js",
      "./retry-core.js",
      "./sdk-errors.js",
      "./sdk-secrets.js",
      "./side-effect-audit.js",
      "./sse.js",
      "./stable.js",
      "./status.js",
      "./submission.js",
      "./suggest.js",
      "./webhook-verify.js",
      "./workflow-status.js",
      "./workspace-resources.js"
    ],
    "contractsBarrelExportSpecifiers": [
      "./provider-support.js",
      "./models.js",
      "./status.js",
      "./submission.js",
      "./runtime-sizes.js",
      "./runtime-kind.js",
      "./runner-event.js",
      "./event-envelope.js",
      "./event-view.js",
      "./event-stream-client.js",
      "./turn-trace.js",
      "./runtime-manifest.js",
      "./session-cost.js",
      "./session-record.js",
      "./canonical-sha256.js",
      "./session-config.js",
      "./bundle-manifest.js",
      "./stable.js",
      "./sdk-secrets.js",
      "./sdk-errors.js",
      "./runtime-types.js",
      "./http.js",
      "./session-artifacts.js",
      "./workspace-resources.js",
      "./sse.js",
      "./webhook-verify.js",
      "./error-codes.js",
      "./error-factory.js",
      "./suggest.js",
      "./api-key.js"
    ]
  }
}
