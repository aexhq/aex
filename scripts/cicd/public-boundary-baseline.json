{
  "schemaVersion": 1,
  "publicDocs": [
    "README.md",
    "SECURITY.md",
    "packages/sdk/README.md",
    "packages/sdk/docs"
  ],
  "publicSourceRoots": [
    {
      "dir": "packages/contracts/src",
      "allowedAexImports": []
    },
    {
      "dir": "packages/sdk/src",
      "allowedAexImports": [
        "@aexhq/contracts"
      ]
    },
    {
      "dir": "packages/cli/src",
      "allowedAexImports": [
        "@aexhq/contracts",
        "@aexhq/sdk"
      ]
    }
  ],
  "contractsPackage": {
    "dir": "packages/contracts",
    "allowedRuntimeDependencies": [
      "zod"
    ]
  },
  "sdkPackage": {
    "dir": "packages/sdk",
    "name": "@aexhq/sdk",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "bin": {},
    "allowedRuntimeDependencies": [
      "zod"
    ],
    "requiredPackedPublicDeclarationTerms": [
      "Aex",
      "SessionHandle",
      "OperationHandle",
      "TelemetryClient"
    ],
    "forbiddenPackedPublicDeclarationTerms": [
      "AssetRef",
      "RuntimeKinds",
      "SDK_VERSION",
      "SessionResult",
      "StartSessionOptions"
    ],
    "allowedPackedPathPrefixes": [
      "package.json",
      "README.md",
      "LICENSE",
      "NOTICE",
      "docs/",
      "dist/"
    ],
    "forbiddenPackedPathPatterns": [
      "(^|/)\\.env(?:\\.|$)",
      "^(?:\\.github|apps|eval|scripts|tools)(?:/|$)",
      "^(?:packages/(?:cli|db|runtime-bridge|shared))(?:/|$)",
      "(^|/)vercel\\.json$"
    ]
  },
  "contractsInline": {
    "sourcePackage": "@aexhq/contracts",
    "sdkPackedPrefix": "dist/_contracts/",
    "allowedModuleFiles": [
      "./api-key.js",
      "./api-routes.js",
      "./error-codes.js",
      "./error-factory.js",
      "./http.js",
      "./ids.js",
      "./index.js",
      "./retry-core.js",
      "./sdk-errors.js",
      "./sdk-secrets.js",
      "./stable.js",
      "./v1-account-billing.js",
      "./v1-content.js",
      "./v1-resources.js",
      "./v1-telemetry.js"
    ],
    "privateModuleMaxBytes": {},
    "contractsBarrelExportSpecifiers": [
      "./api-key.js",
      "./api-routes.js",
      "./error-codes.js",
      "./error-factory.js",
      "./http.js",
      "./ids.js",
      "./sdk-errors.js",
      "./stable.js",
      "./v1-account-billing.js",
      "./v1-content.js",
      "./v1-resources.js",
      "./v1-telemetry.js"
    ]
  }
}
