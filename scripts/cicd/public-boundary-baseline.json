{
  "schemaVersion": 1,
  "publicDocs": [
    "README.md",
    "SECURITY.md",
    "packages/sdk/README.md",
    "packages/sdk/docs"
  ],
  "publicSourceRoots": [
    "packages/contracts/src",
    "packages/sdk/src",
    "packages/cli/src"
  ],
  "temporaryAllowedPublicImports": [
    "@aexhq/contracts",
    "@aexhq/contracts/internal"
  ],
  "contractsPackage": {
    "dir": "packages/contracts",
    "allowedRuntimeDependencies": [
      "@standard-schema/spec",
      "fflate",
      "zod"
    ]
  },
  "sdkPackage": {
    "dir": "packages/sdk",
    "name": "@aexhq/sdk",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "bin": {
      "aex": "./dist/cli.mjs"
    },
    "allowedRuntimeDependencies": [
      "@standard-schema/spec",
      "fflate",
      "ignore",
      "zod"
    ],
    "requiredPackedPublicDeclarationTerms": [
      "StartSessionOptions",
      "SessionCreateOptions",
      "SessionStartOptions",
      "SessionSendOptions"
    ],
    "forbiddenPackedPublicDeclarationTerms": [
      "ExactKeySet",
      "SessionOptionKeyAssertions",
      "assertStartSessionOptions",
      "SESSION_CREATE_KEYS",
      "ASSET_ITEM_KEYS"
    ],
    "allowedPackedPathPrefixes": [
      "package.json",
      "README.md",
      "docs/",
      "dist/"
    ],
    "forbiddenPackedPathPatterns": [
      "(^|/)\\.env(?:\\.|$)",
      "^(?:\\.github|apps|eval|scripts|tools)(?:/|$)",
      "^(?:packages/(?:cli|db|runtime-bridge|shared))(?:/|$)",
      "(^|/)vercel\\.json$"
    ]
  },
