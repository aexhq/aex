  "dependencies": {
    "@aws-sdk/client-lambda": "3.1101.0",
    "@aws-sdk/client-secrets-manager": "3.1101.0",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.8.3"
  }
