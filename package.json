{
  "name": "@aexhq/repository",
  "version": "0.13.3",
  "private": true,
  "description": "Repository for the aex SDK, CLI, contracts, conformance helpers, user tests, and docs.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter @aexhq/contracts build && bun run --filter @aexhq/sdk build && bun run --filter @aexhq/conformance build",
    "lint": "bun run brand:check && bun run --filter @aexhq/contracts build && bun run --filter @aexhq/sdk build && bun run --filter @aexhq/conformance build && tsc --noEmit -p tsconfig.scripts.json && bun run --workspaces --if-present --parallel lint && bun run lint:tests",
    "lint:tests": "eslint --max-warnings=0 && bun scripts/verify-eslint-rules.mjs",
    "lint:tests:verify": "bun scripts/verify-eslint-rules.mjs",
    "brand:check": "bun scripts/cicd/check-old-brand.mjs",
    "terminology:check": "bun scripts/validate/check-session-terminology.mjs",
    "contracts:parity:check": "bun scripts/cicd/check-contract-parity.mjs",
    "test": "bun run test:unit",
    "test:unit": "bun run build && bun run --workspaces --if-present test:unit && bun run --filter @aexhq/sdk test:security && bun run test:validate",
    "test:validate": "bun scripts/cicd/run-validation-tests.mjs",
    "test:user": "bun run --filter @aexhq/user-tests test:user",
    "test:user:files": "bun run --filter @aexhq/user-tests test:user:files",
    "test:user:smoke": "bun run --filter @aexhq/user-tests test:user:smoke",
    "test:user:admission-gates": "bun run --filter @aexhq/user-tests test:user:admission-gates",
    "test:user:offline": "bun run --filter @aexhq/user-tests test:user:offline",
    "test:user:heavy": "bun run --filter @aexhq/user-tests test:user:heavy",
    "test:user:providers": "bun run --filter @aexhq/user-tests test:user:providers",
    "test:user:fuzz": "bun run --filter @aexhq/user-tests test:user:fuzz",
    "test:user:e2e": "bun run --filter @aexhq/user-tests test:user:e2e",
    "test:user:tool-fuzz": "bun run --filter @aexhq/user-tests test:user:tool-fuzz",
    "capabilities:generate": "bun scripts/generate-capability-matrix.ts --write",
    "capabilities:check": "bun scripts/generate-capability-matrix.ts --check",
    "docs:generate": "bun run --filter @aexhq/docs generate",
    "docs:build": "bun run --filter @aexhq/docs build",
    "docs:check": "bun run --filter @aexhq/docs lint",
    "contracts:boundary:check": "bun scripts/with-generated-dist-lock.mjs bun scripts/cicd/check-public-boundary.mjs",
    "pack:sdk": "bun run --filter @aexhq/sdk build && bun run --filter @aexhq/sdk pack:dry-run && bun run contracts:boundary:check"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@vitest/coverage-v8": "3.1.2",
    "dotenv": "16.5.0",
    "eslint": "9.18.0",
    "eslint-plugin-aex": "file:./tools/eslint-plugin-aex",
    "fast-check": "4.3.0",
    "fflate": "0.8.2",
    "semver": "7.8.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.36.0",
    "undici": "7.25.0",
    "vitest": "3.1.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "overrides": {
    "aex": "file:./packages/sdk",
    "next": "16.2.6",
    "fflate": "0.8.3"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
