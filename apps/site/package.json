{
  "name": "@aexhq/site",
  "version": "0.50.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "aex": {
    "owner": "clients",
    "role": "web_app",
    "artifact": "static_site",
    "deployable": "site",
    "live_suite": "aex-live-site",
    "layers": ["unit", "smoke", "e2e", "user"],
    "concerns": ["security", "compatibility"],
    "seams": ["vercel.build_output.deploy"],
    "security_tier": "public_edge",
    "risk": ["generated_code"],
    "scenarios": ["local.site-determinism", "local.site-references"],
    "targets": {
      "generation": "unit",
      "deployed_smoke": "smoke",
      "deployed_references": "e2e",
      "static_user": "user"
    }
  },
  "scripts": {
    "generate": "bun generate/main.ts",
    "build": "bun run generate && node node_modules/next/dist/bin/next build",
    "lint": "tsc --noEmit && bun test --isolate --timeout 120000 test",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test --isolate --timeout 120000 test"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.8.3"
  }
}
