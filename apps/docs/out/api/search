lts#session","content":"20 iterations"},"278":{"id":"/docs/guides/defaults-21","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#session","content":"A positive integer, up to 200"},"279":{"id":"/docs/guides/defaults-22","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"Option"},"280":{"id":"/docs/guides/defaults-23","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"Default"},"281":{"id":"/docs/guides/defaults-24","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"How to override"},"282":{"id":"/docs/guides/defaults-25","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"Per-call exec timeout"},"283":{"id":"/docs/guides/defaults-26","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"30 minutes"},"284":{"id":"/docs/guides/defaults-27","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"Tool call `timeoutMs`"},"285":{"id":"/docs/guides/defaults-28","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"`web_fetch` returned body"},"286":{"id":"/docs/guides/defaults-29","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"500 KB (UTF-8)"},"287":{"id":"/docs/guides/defaults-30","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"Tool argument `max_bytes`"},"288":{"id":"/docs/guides/defaults-31","page_id":"/docs/guides/defaults","tags":[],"type":"text","url":"/docs/guides/defaults#tools-and-mcp","content":"MCP connect timeout"},"289":{"id":"/docs/guides/defaults-32","page_id":"/docs/guides/defaul