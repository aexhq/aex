03--authorization","content":"403 — authorization"},"310":{"id":"/docs/guides/errors-4","page_id":"/docs/guides/errors","type":"heading","tags":[],"url":"/docs/guides/errors#400--validation","content":"400 — validation"},"311":{"id":"/docs/guides/errors-5","page_id":"/docs/guides/errors","type":"heading","tags":[],"url":"/docs/guides/errors#402--payment-required","content":"402 — payment required"},"312":{"id":"/docs/guides/errors-6","page_id":"/docs/guides/errors","type":"heading","tags":[],"url":"/docs/guides/errors#429--rate-limits","content":"429 — rate limits"},"313":{"id":"/docs/guides/errors-7","page_id":"/docs/guides/errors","type":"heading","tags":[],"url":"/docs/guides/errors#404--not-found","content":"404 — not found"},"314":{"id":"/docs/guides/errors-8","page_id":"/docs/guides/errors","type":"heading","tags":[],"url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"409 — conflicts and inactive workspaces"},"315":{"id":"/docs/guides/errors-9","page_id":"/docs/guides/errors","type":"heading","tags":[],"url":"/docs/guides/errors#413503--synchronous-event-archive-limits","content":"413/503 — synchronous event archive limits"},"316":{"id":"/docs/guides/errors-10","page_id":"/docs/guides/errors","type":"heading","tags":[],"url":"/docs/guides/errors#5xx--server-errors","content":"5xx — server errors"},"317":{"id":"/docs/guides/errors-11","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#errors","content":"Every API error is a JSON body with a machine-readable `error` code; most also\r\ncarry a human `message` and the self-describing fields named below."},"318":{"id":"/docs/guides/errors-12","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"The SDK maps every non-2xx response through one factory to a typed exception. All\r\ninherit `AexApiError`, which carries the HTTP `status`, the redacted parsed\r\n`body`, the server's stable `apiCode` (a machine-branchable identity distinct\r\nfrom the human `message`), and a `requestId` for support correlation. The\r\nfactory dispatches to a subclass by code/status:"},"319":{"id":"/docs/guides/errors-13","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"Class"},"320":{"id":"/docs/guides/errors-14","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"Fires for"},"321":{"id":"/docs/guides/errors-15","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"Extra fields"},"322":{"id":"/docs/guides/errors-16","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`AexAuthError`"},"323":{"id":"/docs/guides/errors-17","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`401` / `403` (unauthorized, forbidden, insufficient\\_scope, token\\_invalid/revoked/expired, malformed\\_token)"},"324":{"id":"/docs/guides/errors-18","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`requiredScope` (on `insufficient_scope`)"},"325":{"id":"/docs/guides/errors-19","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`AexIdempotencyConflictError`"},"326":{"id":"/docs/guides/errors-20","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`409` `idempotency_conflict`"},"327":{"id":"/docs/guides/errors-21","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"—"},"328":{"id":"/docs/guides/errors-22","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`AexNotFoundError`"},"329":{"id":"/docs/guides/errors-23","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`404` `not_found`"},"330":{"id":"/docs/guides/errors-24","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"—"},"331":{"id":"/docs/guides/errors-25","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`AexRateLimitError`"},"332":{"id":"/docs/guides/errors-26","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`429` (rate\\_limited, workspace\\_concurrency\\_exceeded, workspace\\_submit\\_rate\\_exceeded)"},"333":{"id":"/docs/guides/errors-27","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`retryAfterMs` (when advertised)"},"334":{"id":"/docs/guides/errors-28","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"`AexApiError` (base)"},"335":{"id":"/docs/guides/errors-29","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"every other stable code (session\\_busy, checkpoint\\_not\\_available, session\\_not\\_terminal, session\\_terminal, event\\_archive\\_too\\_large, event\\_archive\\_deadline\\_exceeded, workspace\\_inactive, insufficient\\_balance, workspace\\_spend\\_cap\\_exceeded, upstream\\_error, internal\\_error, …)"},"336":{"id":"/docs/guides/errors-30","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"—"},"337":{"id":"/docs/guides/errors-31","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"Branch with the exported guards instead of parsing bodies or matching status\r\ncodes: `isAuthError`, `isInsufficientScope`, `isIdempotencyConflict`,\r\n`isNotFound`, and `isRateLimited`."},"338":{"id":"/docs/guides/errors-32","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"The **stable** `apiCode` set the SDK types and dispatches on is: `unauthorized`,\r\n`forbidden`, `insufficient_scope`, `token_invalid`, `token_revoked`,\r\n`token_expired`, `malformed_token`, `not_found`, `idempotency_conflict`,\n`session_busy`, `checkpoint_not_available`, `session_not_terminal`, `session_terminal`,\n`event_archive_too_large`, `event_archive_deadline_exceeded`, `unknown_workspace`,\n`workspace_inactive`, `workspace_concurrency_exceeded`, `workspace_submit_rate_exceeded`,\n`workspace_spend_cap_exceeded`, `insufficient_balance`, `rate_limited`,\r\n`upstream_error`, `internal_error`. A code outside this set (e.g. a validation\r\n`error` a route reports) still surfaces as an `AexApiError` with the `status` and\r\n`body.error` preserved; `apiCode` is then `undefined`."},"339":{"id":"/docs/guides/errors-33","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#typed-errors-in-the-sdk","content":"Transport failures with no HTTP response (DNS, connection refused, TLS reset)\nsurface as `AexNetworkError`; client-side config validation surfaces as\n`SessionConfigValidationError` (`err.code === \"SESSION_CONFIG_INVALID\"`) before any\nrequest is sent. Its stable machine-readable payload is exactly\n`err.details = { field }`, where `field` is the rejected public option path such\nas `overrides.timeout`. Branch on `details.field`; the human `message` may change\nand never includes the rejected value."},"340":{"id":"/docs/guides/errors-34","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"Code"},"341":{"id":"/docs/guides/errors-35","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"Meaning"},"342":{"id":"/docs/guides/errors-36","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"`unauthorized`"},"343":{"id":"/docs/guides/errors-37","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"Missing or empty bearer token."},"344":{"id":"/docs/guides/errors-38","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"`token_invalid`"},"345":{"id":"/docs/guides/errors-39","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"Bearer token is structurally valid but does not match a live credential, has a bad signature, or belongs to an inactive workspace."},"346":{"id":"/docs/guides/errors-40","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"`token_revoked`"},"347":{"id":"/docs/guides/errors-41","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"Bearer token matched a revoked credential."},"348":{"id":"/docs/guides/errors-42","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"`token_expired`"},"349":{"id":"/docs/guides/errors-43","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"Short-lived internal writer token is past its expiry."},"350":{"id":"/docs/guides/errors-44","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#401--authentication","content":"Check the token value and that it has not been deleted or revoked. `aex whoami`\r\nis the cheapest way to validate a credential. See\r\nAuthentication."},"351":{"id":"/docs/guides/errors-45","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#403--authorization","content":"Code"},"352":{"id":"/docs/guides/errors-46","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#403--authorization","content":"Meaning"},"353":{"id":"/docs/guides/errors-47","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#403--authorization","content":"`insufficient_scope`"},"354":{"id":"/docs/guides/errors-48","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#403--authorization","content":"The token is valid but lacks the route's required scope. The body's `requiredScope` field names the missing scope."},"355":{"id":"/docs/guides/errors-49","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#403--authorization","content":"`unknown_workspace`"},"356":{"id":"/docs/guides/errors-50","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#403--authorization","content":"The token does not route to a known workspace."},"357":{"id":"/docs/guides/errors-51","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#403--authorization","content":"`forbidden`"},"358":{"id":"/docs/guides/errors-52","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#403--authorization","content":"The authenticated workspace does not own the addressed resource."},"359":{"id":"/docs/guides/errors-53","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"Code"},"360":{"id":"/docs/guides/errors-54","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"Meaning"},"361":{"id":"/docs/guides/errors-55","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"`bad_request`"},"362":{"id":"/docs/guides/errors-56","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"Missing or unparseable request body."},"363":{"id":"/docs/guides/errors-57","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"`invalid_submission`"},"364":{"id":"/docs/guides/errors-58","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"The submission failed shape validation; `message` names the offending field."},"365":{"id":"/docs/guides/errors-59","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"`missing_provider_key`"},"366":{"id":"/docs/guides/errors-60","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"The submission names a provider but carries no BYOK key for it (`apiKeys[provider]`)."},"367":{"id":"/docs/guides/errors-61","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"`malformed_token`"},"368":{"id":"/docs/guides/errors-62","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"The bearer value is not a structurally valid aex token."},"369":{"id":"/docs/guides/errors-63","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#400--validation","content":"400s are permanent for that request — fix the input rather than retrying.\r\nThe SDK's client-side validation (`SessionConfigValidationError`) catches most of\r\nthese before the request is sent."},"370":{"id":"/docs/guides/errors-64","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#402--payment-required","content":"Two distinct submit gates return 402; both bodies are self-describing."},"371":{"id":"/docs/guides/errors-65","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#402--payment-required","content":"**`insufficient_balance`** — the workspace prepaid balance is at or below the\r\neffective submit floor. Top up the balance or bind a payment method."},"372":{"id":"/docs/guides/errors-66","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#402--payment-required","content":"`balanceGraceFloorUsd` is the payment-method-aware floor the gate compared\r\nagainst (`paymentMethodStatus: \"active\"` folds a bounded card overdraft into\r\nit, so the floor can be negative)."},"373":{"id":"/docs/guides/errors-67","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#402--payment-required","content":"**`workspace_spend_cap_exceeded`** — the workspace's monthly spend cap is\r\nreached. The cap resets at the start of the next UTC month; contact support to\r\nraise it."},"374":{"id":"/docs/guides/errors-68","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#429--rate-limits","content":"**`workspace_concurrency_exceeded`** — admitting one more live run would exceed\r\nthe workspace's concurrent-run cap. Wait for a session to finish, or contact\r\nsupport to raise the cap."},"375":{"id":"/docs/guides/errors-69","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#429--rate-limits","content":"**`workspace_submit_rate_exceeded`** — too many submits in the current\r\none-minute window. Retry shortly."},"376":{"id":"/docs/guides/errors-70","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#429--rate-limits","content":"The `limit`-naming fields (`cap`/`perMin`) and the `observed` window value make\r\neach deny self-describing, so a client can back off proportionally. To\r\nanticipate both 429s and both 402s *before* submitting, read the effective caps\r\nfrom `aex.whoami().limits` — the values come from the same resolution code the\r\ngates enforce. See Limits & quotas."},"377":{"id":"/docs/guides/errors-71","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#404--not-found","content":"`not_found`: the id does not exist **or** belongs to another workspace (aex\r\ndoes not distinguish the two). The SDK raises `AexNotFoundError` (guard:\r\n`isNotFound(err)`)."},"378":{"id":"/docs/guides/errors-72","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"Code"},"379":{"id":"/docs/guides/errors-73","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"Meaning"},"380":{"id":"/docs/guides/errors-74","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"`idempotency_conflict`"},"381":{"id":"/docs/guides/errors-75","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"The `idempotencyKey` was already used with a different request body. The SDK raises `AexIdempotencyConflictError` (guard: `isIdempotencyConflict(err)`)."},"382":{"id":"/docs/guides/errors-76","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"`session_busy`"},"383":{"id":"/docs/guides/errors-77","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"The session is handling another turn or lifecycle transition. Wait for its current operation to finish."},"384":{"id":"/docs/guides/errors-78","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"`checkpoint_not_available`"},"385":{"id":"/docs/guides/errors-79","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"No committed checkpoint exists yet for a checkpoint-backed read such as `session.files.list()`. Wait for the current run to finish. This remains a base `AexApiError`, not an idempotency conflict."},"386":{"id":"/docs/guides/errors-80","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"`session_not_terminal`"},"387":{"id":"/docs/guides/errors-81","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"The requested operation requires a terminal session state."},"388":{"id":"/docs/guides/errors-82","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"`session_terminal`"},"389":{"id":"/docs/guides/errors-83","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"The session has ended and cannot perform the requested action."},"390":{"id":"/docs/guides/errors-84","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"`workspace_inactive`"},"391":{"id":"/docs/guides/errors-85","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"A workspace deletion fence won the admission race, so the workspace no longer accepts new session work. The body carries `workspaceStatus` (normally `deleting`). Use an active workspace."},"392":{"id":"/docs/guides/errors-86","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"For `idempotency_conflict`, use a fresh idempotency key for a genuinely new request, or resubmit\nthe byte-identical body to replay the original result (a matching retry returns\nthe existing session rather than conflicting). Note that the SDK validates the\nkey client-side first: an empty or whitespace-only `idempotencyKey` throws\n`SessionConfigValidationError` before the request is sent, as does a key longer\nthan 255 characters. Never pass `\"\"`."},"393":{"id":"/docs/guides/errors-87","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#409--conflicts-and-inactive-workspaces","content":"`workspace_inactive` is not an idempotency conflict and is not transient for\nthat workspace. It remains a base `AexApiError`; branch on\n`err.apiCode === \"workspace_inactive\"` and inspect `err.body.workspaceStatus`\nwhen the current lifecycle state matters."},"394":{"id":"/docs/guides/errors-88","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#413503--synchronous-event-archive-limits","content":"Code"},"395":{"id":"/docs/guides/errors-89","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#413503--synchronous-event-archive-limits","content":"Meaning"},"396":{"id":"/docs/guides/errors-90","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#413503--synchronous-event-archive-limits","content":"`event_archive_too_large` (413)"},"397":{"id":"/docs/guides/errors-91","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#413503--synchronous-event-archive-limits","content":"The history exceeds the synchronous archive's source, candidate, or estimated-output limit."},"398":{"id":"/docs/guides/errors-92","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#413503--synchronous-event-archive-limits","content":"`event_archive_deadline_exceeded` (503)"},"399":{"id":"/docs/guides/errors-93","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#413503--synchronous-event-archive-limits","content":"The synchronous archive could not finish inside its server request budget."},"400":{"id":"/docs/guides/errors-94","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#413503--synchronous-event-archive-limits","content":"Both are stable base `AexApiError` codes with `retryable: false`. The SDK does\nnot retry `session.events.archiveLink()` automatically. Traverse the history\nwith `session.events.iterate()` instead of repeating the bulk export."},"401":{"id":"/docs/guides/errors-95","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#5xx--server-errors","content":"Code"},"402":{"id":"/docs/guides/errors-96","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#5xx--server-errors","content":"Meaning"},"403":{"id":"/docs/guides/errors-97","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#5xx--server-errors","content":"`internal_error` (500)"},"404":{"id":"/docs/guides/errors-98","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#5xx--server-errors","content":"Unexpected server fault. Retry with backoff; report persistent cases."},"405":{"id":"/docs/guides/errors-99","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#5xx--server-errors","content":"`db_resuming` (503)"},"406":{"id":"/docs/guides/errors-100","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#5xx--server-errors","content":"The database tier is resuming from idle. Transient — retry."},"407":{"id":"/docs/guides/errors-101","page_id":"/docs/guides/errors","tags":[],"type":"text","url":"/docs/guides/errors#5xx--server-errors","content":"The SDK retries transient failures automatically: HTTP `429`, `5xx`, `529`, and\r\nnetwork errors get bounded exponential backoff with full jitter, honoring any\r\n`Retry-After` header. Tune or disable this with the client `retry` option; use\r\n`isRateLimited(err)` / `AexRateLimitError` to handle persistent throttling\r\nwithout parsing raw bodies. Automatic retries are limited to reads and other\r\nidempotent HTTP methods, or mutations carrying a stable `Idempotency-Key`.\r\nSession create/send requests always carry one stable key across transport\r\nattempts, so a retried request cannot create a second billable run. The SDK\r\nnever retries an entire user scenario or a failed application run."},"408":{"id":"/docs/guides/events","page_id":"/docs/guides/events","type":"page","content":"Events","breadcrumbs":["aex","Guides"],"tags":[],"url":"/docs/guides/events"},"409":{"id":"/docs/guides/events-0","page_id":"/docs/guides/events","type":"heading","tags":[],"url":"/docs/guides/events#events","content":"Events"},"410":{"id":"/docs/guides/events-1","page_id":"/docs/guides/events","type":"heading","tags":[],"url":"/docs/guides/events#run-lifecycle","content":"Run lifecycle"},"411":{"id":"/docs/guides/events-2","page_id":"/docs/guides/events","type":"heading","tags":[],"url":"/docs/guides/events#live-stream","content":"Live stream"},"412":{"id":"/docs/guides/events-3","page_id":"/docs/guides/events","type":"heading","tags":[],"url":"/docs/guides/events#assistant-messages","content":"Assistant messages"},"413":{"id":"/docs/guides/events-4","page_id":"/docs/guides/events","type":"heading","tags":[],"url":"/docs/guides/events#output-granularity","content":"Output granularity"},"414":{"id":"/docs/guides/events-5","page_id":"/docs/guides/events","type":"heading","tags":[],"url":"/docs/guides/events#archives","content":"Archives"},"415":{"id":"/docs/guides/events-6","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#events","content":"Durable event reads use one `AexEventView` shape with CloudEvents identity,\r\nmonotonic `sequence`, real AG-UI `threadId`, and real `runId`."},"416":{"id":"/docs/guides/events-7","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#events","content":"`iterate()` follows cursor pages lazily and retains at most one API page. Use\n`list()` only when the full history is known to fit comfortably in memory."},"417":{"id":"/docs/guides/events-8","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#run-lifecycle","content":"The public lifecycle is:"},"418":{"id":"/docs/guides/events-9","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#run-lifecycle","content":"`RUN_STARTED`: the accepted run began."},"419":{"id":"/docs/guides/events-10","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#run-lifecycle","content":"`RUN_FINISHED`: all run state is committed, including the checkpoint."},"420":{"id":"/docs/guides/events-11","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#run-lifecycle","content":"`RUN_ERROR`: the run failed. It may have no checkpoint when failure happened\r\nbefore a checkpoint could be created."},"421":{"id":"/docs/guides/events-12","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#run-lifecycle","content":"Runtime execution ending is internal and is not emitted as a public lifecycle\r\nevent. Consumers observe only the committed `RUN_FINISHED` or `RUN_ERROR`\r\nterminal boundary."},"422":{"id":"/docs/guides/events-13","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#run-lifecycle","content":"Message sends do not accept a historical `from` cursor. Their stream and\nfinished result are scoped to the run accepted by that send, so events from an\nearlier run cannot be replayed into the current result. Use\n`session.events.iterate()`, `.list()`, `.stream({ from })`, or\n`.streamEnvelopes({ from })`\nwhen intentionally reading session history."},"423":{"id":"/docs/guides/events-14","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#run-lifecycle","content":"`finished()` and `aex.start()` return the same run outcome vocabulary:\r\n`succeeded`, `failed`, `timed_out`, `cancelled`, or `interrupted`. A run held by\r\nsuspension or approval is `interrupted`; the session lifecycle separately says\r\n`suspended` or `awaiting_approval`. Only `succeeded` sets `result.ok` to true."},"424":{"id":"/docs/guides/events-15","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#live-stream","content":"`session.messages.send(...)` and `session.events.streamEnvelopes(...)` yield\r\n`AexStreamEventView`, a discriminated union:"},"425":{"id":"/docs/guides/events-16","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#live-stream","content":"Durable events have `sequence` and are replayable. They are the only events\r\nreturned by `events.iterate()`, `events.list()`, polling streams, archives,\nand finished results."},"426":{"id":"/docs/guides/events-17","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#live-stream","content":"Provisional live events have `replayable: false`, a per-run `liveSequence`,\r\nand no durable `sequence`. They are not replayed from storage."},"427":{"id":"/docs/guides/events-18","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#live-stream","content":"The SDK mints a short-lived coordinator ticket, reconnects durable events from\nthe last sequence after transient transport loss, deduplicates repeated live\r\nframes by event id, and stops on a durable run terminal. The caller can tune\r\ntransport watchdogs with `idleTimeoutMs`, `pingIntervalMs`, and\r\n`eventQuietRecheckMs`; these reconnect the event transport and never retry an\r\napplication run."},"428":{"id":"/docs/guides/events-19","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#live-stream","content":"For a polling snapshot stream, use `session.events.stream()`. At invocation it\ntargets the session's current run, or its last completed run when idle. Older\nrun terminals cannot end that poll. The inclusive `from` cursor\n(`sequence >= from`) filters yielded history without hiding the target run's\ncompletion boundary:"},"429":{"id":"/docs/guides/events-20","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#live-stream","content":"The cursor must be a non-negative safe integer. A session with no runs returns\none bounded snapshot instead of waiting for a terminal that cannot exist. For\nan explicitly bounded read, use `session.events.list()`."},"430":{"id":"/docs/guides/events-21","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#assistant-messages","content":"Messages are a separate resource from raw events:"},"431":{"id":"/docs/guides/events-22","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#assistant-messages","content":"Messages come directly from the messages endpoint. A missing or broken route is\r\nsurfaced as an API failure rather than projected from another resource."},"432":{"id":"/docs/guides/events-23","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#output-granularity","content":"`outputMode: \"buffered\"` emits coalesced assistant text. `\"stream\"` first emits\r\nprovisional live token deltas, then exactly one durable coalesced\r\n`TEXT_MESSAGE_CONTENT` before the run terminal. Final `result.text`,\r\n`result.messages`, and `result.events` use the durable coalesced event and do\r\nnot duplicate provisional deltas. Stream mode is rejected before submission\r\nfor providers that do not support it; it is never silently downgraded."},"433":{"id":"/docs/guides/events-24","page_id":"/docs/guides/events","tags":[],"type":"text","url":"/docs/guides/events#archives","content":"The event archive uses the same redacted public events returned by the SDK.\n`archiveLink()` is a bounded convenience export. A session that exceeds the\nbulk-export limits returns a typed `413` API error; an export that cannot finish\ninside the server's request budget returns a typed `503` API error. The SDK does\nnot retry either response automatically. Traverse large histories with\n`for await (const event of session.events.iterate())`; iteration follows bounded\ncursor pages without retaining the whole history. `events.list()` and\n`events.download()` are materializing convenience methods."},"434":{"id":"/docs/guides/files","page_id":"/docs/guides/files","type":"page","content":"Files","breadcrumbs":["aex","Guides"],"tags":[],"url":"/docs/guides/files"},"435":{"id":"/docs/guides/files-0","page_id":"/docs/guides/files","type":"heading","tags":[],"url":"/docs/guides/files#files","content":"Files"},"436":{"id":"/docs/guides/files-1","page_id":"/docs/guides/files","type":"heading","tags":[],"url":"/docs/guides/files#reusable-workspace-files","content":"Reusable workspace files"},"437":{"id":"/docs/guides/files-2","page_id":"/docs/guides/files","type":"heading","tags":[],"url":"/docs/guides/files#session-file-snapshots","content":"Session file snapshots"},"438":{"id":"/docs/guides/files-3","page_id":"/docs/guides/files","type":"heading","tags":[],"url":"/docs/guides/files#find-and-read","content":"Find and read"},"439":{"id":"/docs/guides/files-4","page_id":"/docs/guides/files","type":"heading","tags":[],"url":"/docs/guides/files#download-and-links","content":"Download and links"},"440":{"id":"/docs/guides/files-5","page_id":"/docs/guides/files","type":"heading","tags":[],"url":"/docs/guides/files#failed-runs","content":"Failed runs"},"441":{"id":"/docs/guides/files-6","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#files","content":"There are two different file concepts:"},"442":{"id":"/docs/guides/files-7","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#files","content":"`aex.workspace.files`: reusable, versioned input resources."},"443":{"id":"/docs/guides/files-8","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#files","content":"`session.files`: files captured from one session checkpoint."},"444":{"id":"/docs/guides/files-9","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#files","content":"Raw uploaded bytes are assets. A workspace file is a typed resource that pins\nan asset, logical resource ID, version, hash, name, and mount path."},"445":{"id":"/docs/guides/files-10","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#files","content":"`mountPath` is always a destination directory. The runtime preserves each\nsource/archive filename inside that directory, so an `input.csv` published\nwith `mountPath: \"/workspace/input\"` appears at\n`/workspace/input/input.csv`. A `name` passed to `File.fromPath` is only the\nresource's storage slug; it never renames the mounted file. Multiple files can\nintentionally share one mount directory as long as their resulting paths do\nnot collide."},"446":{"id":"/docs/guides/files-11","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#reusable-workspace-files","content":"`publish()` uploads immutable bytes, then creates or versions the workspace\r\nresource. `list()`, `get(resourceId, version?)`, and `delete(resourceId)` manage\nthe catalog. Runs always receive pinned refs; they never resolve a mutable\n\"latest\" version during execution."},"447":{"id":"/docs/guides/files-12","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#reusable-workspace-files","content":"As a run boots, each attached input archive is checked against a separate\nruntime materialization envelope: at most 64 MiB compressed, 128 MiB expanded,\nand 1,000 materialized files or safe symlinks. The runtime may overlap bulk skill extraction with\nthe first model call, but it blocks the first tool, any post-run hook, and run\ncompletion until every promised input is ready. These execution-safety bounds\nare distinct from the broader raw-asset storage quota. The SDK and workspace\npublisher reject known violations before a resource can be pinned, and the\nruntime revalidates the immutable archive before use. An invalid input fails explicitly;\ntools and terminal results never observe a silently partial input tree."},"448":{"id":"/docs/guides/files-13","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#session-file-snapshots","content":"`SessionFilesSnapshot` contains both `revision` and `files`. Every file carries\nthe same `checkpointId` as the revision, plus its exact `sizeBytes` and\nlowercase `sha256` digest. After `RUN_FINISHED`, this is the final committed\nstate for that run. During an active run, an older complete checkpoint may\nstill be visible."},"449":{"id":"/docs/guides/files-14","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#find-and-read","content":"Use `list(query?)`, `find(query)`, or `findOne(query)`. Cross-session file\r\nsearch is not part of the public SDK. Open the owning session and query its\r\ncheckpoint instead."},"450":{"id":"/docs/guides/files-15","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#download-and-links","content":"ID selectors must include their checkpoint:"},"451":{"id":"/docs/guides/files-16","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#download-and-links","content":"A string ID alone is intentionally rejected because an ID without a revision\ncan resolve inconsistently after a later run."},"452":{"id":"/docs/guides/files-17","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#download-and-links","content":"`download()` resolves the selector against that checkpoint and verifies both\nthe byte length and SHA-256 digest before returning. An integrity mismatch\nfails immediately and is not retried. `read()` remains a bounded prefix read\nfor large files and verifies integrity when it consumes the complete file.\n`link()` returns the resolved file metadata alongside the direct storage URL;\n`fetch()` returns only the raw one-shot storage `Response`, so retain metadata\nfrom `list()`, `findOne()`, or `link()` when independently verifying that stream."},"453":{"id":"/docs/guides/files-18","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#download-and-links","content":"Omit the selector from `session.files.download()` to download the files\r\nnamespace archive. `session.download()` returns the complete public session\r\narchive containing metadata, events, and files."},"454":{"id":"/docs/guides/files-19","page_id":"/docs/guides/files","tags":[],"type":"text","url":"/docs/guides/files#failed-runs","content":"A `RUN_ERROR` can occur before any checkpoint exists. In that case the result\r\nhas `files: []` and `checkpoint === undefined`. A `RUN_FINISHED` without a\r\ncheckpoint is a contract error and the SDK fails loudly."},"455":{"id":"/docs/guides/limits-and-quotas","page_id":"/docs/guides/limits-and-quotas","type":"page","content":"Limits & quotas","breadcrumbs":["aex","Guides"],"tags":[],"url":"/docs/guides/limits-and-quotas"},"456":{"id":"/docs/guides/limits-and-quotas-0","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#limits--quotas","content":"Limits & quotas"},"457":{"id":"/docs/guides/limits-and-quotas-1","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#session-scope","content":"Session scope"},"458":{"id":"/docs/guides/limits-and-quotas-2","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#sessionfile-capture","content":"SessionFile capture"},"459":{"id":"/docs/guides/limits-and-quotas-3","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#tool-output","content":"Tool output"},"460":{"id":"/docs/guides/limits-and-quotas-4","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#attached-archives","content":"Attached archives"},"461":{"id":"/docs/guides/limits-and-quotas-5","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#subagents","content":"Subagents"},"462":{"id":"/docs/guides/limits-and-quotas-6","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#managed-runtime","content":"Managed runtime"},"463":{"id":"/docs/guides/limits-and-quotas-7","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#workspace-scope","content":"Workspace scope"},"464":{"id":"/docs/guides/limits-and-quotas-8","page_id":"/docs/guides/limits-and-quotas","type":"heading","tags":[],"url":"/docs/guides/limits-and-quotas#request-scope","content":"Request scope"},"465":{"id":"/docs/guides/limits-and-quotas-9","page_id":"/docs/guides/limits-and-quotas","tags":[],"type":"text","url":"/docs/guides/limits-and-quotas#limits--quotas","content":"These public ceilings bound a session, workspace, or request. Defaults that\r\napply when you omit an option are also summarized in Defaults.\r\nYour workspace's effective adjustable limits are available from `aex.whoami()`\r\n(CLI: `aex whoami`); contact support when a documented limit is adjustable but\r\nyour workspace needs a higher value."},"466":{"id":"/docs/guides/limits-and-quotas-10","page_id":"/docs/guides/limits-and-quotas","tags":[],"type":"text","url":"/docs/guides/limits-and-quotas#session-scope","content":"Limit"},"467":{"id":"/docs/guides/limits-and-quotas-11","page_id":"/docs/guides/limits-and-quotas","tags":[],"type":"text","url":"/docs/guides/limits-and-quotas#session-scope","content":"Value"},"468":{"id":"/docs/guides/limits-and-quotas-12","page_id":"/docs/guides/limits-and-quotas","tags":[],"type":"text","url":"/docs/guides/limits-and-quotas#session-scope","