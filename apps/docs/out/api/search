ientScope(err)`"},"1905":{"id":"/docs/reference/sdk-951","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#ismodelname","content":"`isModelName(input)`"},"1906":{"id":"/docs/reference/sdk-952","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isnotfound","content":"True for a 404 not-found error."},"1907":{"id":"/docs/reference/sdk-953","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isnotfound","content":"`isNotFound(err)`"},"1908":{"id":"/docs/reference/sdk-954","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isratelimited","content":"True for a 429 rate/concurrency-limit error."},"1909":{"id":"/docs/reference/sdk-955","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isratelimited","content":"`isRateLimited(err)`"},"1910":{"id":"/docs/reference/sdk-956","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isstreamableprovider","content":"True when a provider has a streaming producer wired (a STREAMABLE\\_SHAPES shape)."},"1911":{"id":"/docs/reference/sdk-957","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isstreamableprovider","content":"`isStreamableProvider(provider)`"},"1912":{"id":"/docs/reference/sdk-958","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isterminalsessionstatus","content":"True when a session thread has been deleted or expired."},"1913":{"id":"/docs/reference/sdk-959","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isterminalsessionstatus","content":"`isTerminalSessionStatus(status)`"},"1914":{"id":"/docs/reference/sdk-960","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isthrottlefault","content":"True when a ProviderFault represents a \"back off and retry\" signal."},"1915":{"id":"/docs/reference/sdk-961","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#isthrottlefault","content":"`isThrottleFault(fault)`"},"1916":{"id":"/docs/reference/sdk-962","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"Reject input paths that try to escape the bundle root or smuggle\nplatform-specific syntax. Returns the canonical forward-slash\nrelative path; never returns paths starting or ending with `/`."},"1917":{"id":"/docs/reference/sdk-963","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"Rejects:"},"1918":{"id":"/docs/reference/sdk-964","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"empty strings and pure whitespace"},"1919":{"id":"/docs/reference/sdk-965","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"absolute paths (`/foo`, `C:\\foo`, `\\\\server\\share`)"},"1920":{"id":"/docs/reference/sdk-966","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"backslash separators (Windows)"},"1921":{"id":"/docs/reference/sdk-967","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"`..` segments anywhere in the path"},"1922":{"id":"/docs/reference/sdk-968","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"`.` segments anywhere except a leading bare `.`"},"1923":{"id":"/docs/reference/sdk-969","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"paths whose length exceeds `SKILL_BUNDLE_LIMITS.maxPathLength`"},"1924":{"id":"/docs/reference/sdk-970","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"paths whose depth exceeds `SKILL_BUNDLE_LIMITS.maxDepth`"},"1925":{"id":"/docs/reference/sdk-971","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"NUL bytes"},"1926":{"id":"/docs/reference/sdk-972","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#normaliseskillbundlepath","content":"`normaliseSkillBundlePath(input)`"},"1927":{"id":"/docs/reference/sdk-973","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseapikey","content":"Parse a self-describing API key, or `null` for any opaque, malformed, or tampered\nvalue. Validates the `aex_` prefix, the 6-part shape, a known plane and\nregion code, and the CRC over the first 5 parts."},"1928":{"id":"/docs/reference/sdk-974","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseapikey","content":"`parseApiKey(token)`"},"1929":{"id":"/docs/reference/sdk-975","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseapprovalgate","content":"Parse the optional `submission.approvalGate`. Absent / empty tool list ⇒\nundefined (no gate). Tool names are deduped; the strict allow-list mirrors the\nsibling parsers."},"1930":{"id":"/docs/reference/sdk-976","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseapprovalgate","content":"`parseApprovalGate(input)`"},"1931":{"id":"/docs/reference/sdk-977","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parsemodelname","content":"`parseModelName(input, field)`"},"1932":{"id":"/docs/reference/sdk-978","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseproviderfault","content":"Best-effort parse of an unknown value into a ProviderFault. Tolerant\r\nof two shapes so the SDK consumes the runtime fault the moment it starts\r\nemitting one, without a contracts change:"},"1933":{"id":"/docs/reference/sdk-979","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseproviderfault","content":"The canonical `{ provider?, kind, status?, retryAfterMs?, message? }`\r\n(optionally nested under a `providerFault` key), OR"},"1934":{"id":"/docs/reference/sdk-980","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseproviderfault","content":"A raw upstream error `{ type: \"rate_limit_error\" | \"overloaded_error\" | ..., message?, retry_after? | retryAfter? }` — `type` maps to `kind`\r\nand `retry_after` (seconds) maps to `retryAfterMs`."},"1935":{"id":"/docs/reference/sdk-981","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseproviderfault","content":"Returns `undefined` when the value carries no recognizable fault."},"1936":{"id":"/docs/reference/sdk-982","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseproviderfault","content":"`parseProviderFault(value)`"},"1937":{"id":"/docs/reference/sdk-983","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseresponseformat","content":"Parse the optional `submission.responseFormat`. Mirrors parseOutputMode\n/ OUTPUT\\_MODES: absent ⇒ undefined; a bad `kind` or unknown subfield is\nrejected (fail-fast). `json_schema` requires a JSON-object `schema`."},"1938":{"id":"/docs/reference/sdk-984","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#parseresponseformat","content":"`parseResponseFormat(input)`"},"1939":{"id":"/docs/reference/sdk-985","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#providerformodel","content":"The default upstream provider for a model id — the first provider declared\nfor it in MODEL\\_PROVIDER\\_IDS. Returns `undefined` when the input is\nnot a known ModelName (so the SDK can fall back to the default and let\nthe server reject the model)."},"1940":{"id":"/docs/reference/sdk-986","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#providerformodel","content":"`providerForModel(model)`"},"1941":{"id":"/docs/reference/sdk-987","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#providersformodel","content":"All upstream providers that can serve a model id, in declaration order.\nReturns `[]` for an unknown model."},"1942":{"id":"/docs/reference/sdk-988","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#providersformodel","content":"`providersForModel(model)`"},"1943":{"id":"/docs/reference/sdk-989","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#redactsecrets","content":"`redactSecrets(value)`"},"1944":{"id":"/docs/reference/sdk-990","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#resolvebuiltintoolnames","content":"`resolveBuiltinToolNames(selection)`"},"1945":{"id":"/docs/reference/sdk-991","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#resolvemodelprovider","content":"The single model→provider resolver shared by the SDK and the CLI, wrapping\nprovidersForModel with the forward-compat unknown-model allowance:"},"1946":{"id":"/docs/reference/sdk-992","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#resolvemodelprovider","content":"`provider` given: it is honored. If `model` is a KNOWN id, the provider\nmust serve it (else throw). If `model` is UNKNOWN, it is allowed through\nso a slightly-old client can still run a newly-launched model (the server\narbitrates)."},"1947":{"id":"/docs/reference/sdk-993","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#resolvemodelprovider","content":"`provider` omitted: a known model resolves to its DEFAULT provider (first\ndeclared). An UNKNOWN model with no provider throws a `did you mean?`\nhint — you must name a provider to run a model this client doesn't know."},"1948":{"id":"/docs/reference/sdk-994","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#resolvemodelprovider","content":"Returns the resolved ProviderName."},"1949":{"id":"/docs/reference/sdk-995","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#resolvemodelprovider","content":"`resolveModelProvider(model, provider)`"},"1950":{"id":"/docs/reference/sdk-996","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#resolveprovidermodelid","content":"Translate a canonical model id + provider into the provider-native model\nstring the upstream API expects (e.g. `(\"gpt-4o-mini\", \"openrouter\")` →\n`\"openai/gpt-4o-mini\"`). Throws when the provider does not serve the model."},"1951":{"id":"/docs/reference/sdk-997","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#resolveprovidermodelid","content":"`resolveProviderModelId(model, provider)`"},"1952":{"id":"/docs/reference/sdk-998","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#suggest","content":"The closest candidate to `input` by a unique case-insensitive prefix match,\nelse by Levenshtein distance (≤ 2), else `undefined`. Ties break by\ndeclaration order. Used on an invalid `--model` / `--provider` /\n`--runtime-size` (and the SDK's unknown-model throw) to turn a flat rejection\ninto a fix hint."},"1953":{"id":"/docs/reference/sdk-999","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#suggest","content":"`suggest(input, candidates)`"},"1954":{"id":"/docs/reference/sdk-1000","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#usagefromproviderusage","content":"Project a UsageSummary from the terminal event's\nSessionCostProviderUsage entries — the SINGLE server source of token\nusage (Session.costTelemetry`.providerUsage`). Sums each field across all\nprovider entries; a field is present only when at least one entry carried it.\nThis retires the dead `session.usage` / `aex.usage`-event usage path: the SDK\nderives usage from cost telemetry, never re-reads a dual-written top-level\n`usage`. Pure."},"1955":{"id":"/docs/reference/sdk-1001","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#usagefromproviderusage","content":"`usageFromProviderUsage(providerUsage)`"},"1956":{"id":"/docs/reference/sdk-1002","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundleentry","content":"Validate one manifest entry: normalises the path, bounds the size,\nand sanitises the mode to one of \\{defaultFileMode, defaultDirMode}.\nThe bundle is files-only, so any non-regular-file entry is rejected\nupstream by the caller (zip parser must skip symlinks, device files,\netc. before reaching this function)."},"1957":{"id":"/docs/reference/sdk-1003","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundleentry","content":"`validateSkillBundleEntry(input)`"},"1958":{"id":"/docs/reference/sdk-1004","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"Validate a full **skill bundle** manifest. Enforces:"},"1959":{"id":"/docs/reference/sdk-1005","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"entries is a non-empty array"},"1960":{"id":"/docs/reference/sdk-1006","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"`SKILL.md` exists at the bundle root (this is what makes a\nbundle a skill rather than a plain workspace file)"},"1961":{"id":"/docs/reference/sdk-1007","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"file count \\<= maxFiles"},"1962":{"id":"/docs/reference/sdk-1008","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"total uncompressed size \\<= maxDecompressedBytes"},"1963":{"id":"/docs/reference/sdk-1009","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"per-entry validation (see `validateSkillBundleEntry`)"},"1964":{"id":"/docs/reference/sdk-1010","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"no duplicate paths"},"1965":{"id":"/docs/reference/sdk-1011","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"In this public surface, **skill** means \"Claude Skill\" — bundles without\n`SKILL.md` are not skills and must go\nthrough workspace instructions or file uploads instead."},"1966":{"id":"/docs/reference/sdk-1012","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"Returns a canonical manifest with totals computed."},"1967":{"id":"/docs/reference/sdk-1013","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#validateskillbundlemanifest","content":"`validateSkillBundleManifest(input)`"},"1968":{"id":"/docs/reference/sdk-1014","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#verifyaexwebhook","content":"Verify an aex webhook delivery. Returns `true` only when the timestamp is\nwithin tolerance AND one of the `v1,<base64>` entries in `webhook-signature`\nmatches the HMAC over `${id}.${timestamp}.${rawBody}`. Constant-time compare;\nnever throws on a bad signature (only on a malformed secret)."},"1969":{"id":"/docs/reference/sdk-1015","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#verifyaexwebhook","content":"`verifyAexWebhook(input)`"},"1970":{"id":"/docs/reference/sdk-1016","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#aex_api_error_codes","content":"SSoT for the platform's STABLE API error codes."},"1971":{"id":"/docs/reference/sdk-1017","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#aex_api_error_codes","content":"The server (platform `api.ts`) imports this table instead of keeping its\nown private copy, so a route emitting a code absent from the union fails to\ncompile and adding a code without a message is caught. The SDK error factory\n(import(\"./error-factory.js\").apiErrorFromResponse) dispatches on the\ncode to a typed subclass; the CLI maps it to a human remedy."},"1972":{"id":"/docs/reference/sdk-1018","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#aex_api_error_codes","content":"The code is the stable, machine-branchable identity of a failure — distinct\nfrom the human `message`. `idempotency_conflict` and `insufficient_scope`\n(previously message-less bare 409/403 bodies) are first-class here."},"1973":{"id":"/docs/reference/sdk-1019","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#aex_api_error_messages","content":"Human message per stable code. A `Record` (not `Partial`) so a code added to\nAEX\\_API\\_ERROR\\_CODES without a message is a COMPILE error. These are\nthe fallback messages the factory uses when the server sends a BARE code with\nno `message` detail."},"1974":{"id":"/docs/reference/sdk-1020","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#aex_api_error_remedies","content":"Optional per-code fix hint the CLI surfaces alongside the error message."},"1975":{"id":"/docs/reference/sdk-1021","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#asset_archive_limits","content":"One honest envelope for every file, skill, tool, or instruction archive that\nthe managed runtime mounts. Raw asset storage is a broader concept and may\nhave a different quota; these limits describe usable runtime inputs."},"1976":{"id":"/docs/reference/sdk-1022","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#builtin_tool_names","content":"The CLOSED set of builtin tool NAMES the managed runtime can inject — one per\nmachine tool the hands implement. This list is the single source of truth for\nvalidating builtin tool references; the platform's `HANDS_TOOLS` (the execute\nvocabulary) is pinned EQUAL to it at module load (`platform-runtime-agent`\n`assertNamesMatch`), so a rename on either side fails loudly rather than\nsilently shipping a name the executors do not speak."},"1977":{"id":"/docs/reference/sdk-1023","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#builtin_tool_names","content":"Order mirrors `HANDS_TOOLS`. A builtin tool reference (a bare string in\n`submission.tools`) must be a member of this set."},"1978":{"id":"/docs/reference/sdk-1024","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#builtintools","content":"Typo-safe accessors for the closed builtin tool set: each key maps to the\nreal tool NAME string. Reference a builtin in `submission.tools` via\n`BuiltinTools.web_search` rather than the bare string so a rename is a\ncompile error, not a runtime 400."},"1979":{"id":"/docs/reference/sdk-1025","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#builtintools","content":"Keys are the real tool names; a unit test asserts `Object.values(BuiltinTools)`\ndeep-equals `BUILTIN_TOOL_NAMES` so the two can never drift."},"1980":{"id":"/docs/reference/sdk-1026","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#default_builtin_tools","content":"The complete builtin set selected by `builtinTools: \"default\"`."},"1981":{"id":"/docs/reference/sdk-1027","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#default_runtime_kind","content":"Default when `runtimeKind` is omitted (today's co-located Fargate path)."},"1982":{"id":"/docs/reference/sdk-1028","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#default_runtime_size","content":"Default when `runtimeSize` is omitted (the 1 GB tier)."},"1983":{"id":"/docs/reference/sdk-1029","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#model_provider_ids","content":"Source of truth for the closed model set: each canonical model id maps to the\nupstream providers that can serve it and the **provider-native** model string\neach one expects."},"1984":{"id":"/docs/reference/sdk-1030","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#model_provider_ids","content":"`Models.*` / `SUPPORTED_MODELS` are aex's own **canonical, provider-neutral**\nidentifiers — they are NOT the strings sent to a provider. The platform\ntranslates a `(canonical model, provider)` pair to the native id via\nresolveProviderModelId when it builds the session's session manifest. The\nsame canonical model can therefore be served by more than one provider (e.g.\n`gpt-4o-mini` via `openai` *or* `openrouter`), with a different native string\nper provider."},"1985":{"id":"/docs/reference/sdk-1031","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#model_provider_ids","content":"Ordering matters: the **first** provider listed for a model is its default\n(see providerForModel) — list the native vendor before `openrouter`.\nAdditions belong here first so SDK types, CLI validation, docs examples, and\nplatform parsing all move together."},"1986":{"id":"/docs/reference/sdk-1032","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#models","content":"Symbol-style accessors for the closed model set. Prefer these over raw\nstrings so an invalid token is a compile error, not a runtime 400 — e.g.\n`Models.CLAUDE_HAIKU_4_5`. These are aex's **canonical** ids, not the native\nstrings sent upstream; the platform translates them per provider (see\nMODEL\\_PROVIDER\\_IDS / resolveProviderModelId). When a model is\nserved by more than one provider, pair it with an explicit Providers\nvalue; otherwise the single (default) provider is used."},"1987":{"id":"/docs/reference/sdk-1033","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#plane_base_urls","content":"Plane → API base URL. When the SDK constructor is given no explicit `baseUrl`\nit DERIVES the target from the API key's embedded plane (see\nimport(\"./api-key.js\").parseApiKey) rather than blindly defaulting to\nprod — so a dev key routes to `dev-api.aex.dev` and a prd key routes to\n`api.aex.dev`."},"1988":{"id":"/docs/reference/sdk-1034","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#plane_base_urls","content":"The plane-mismatch guard still fires when a key is pointed at the wrong\ncanonical host (for example, a dev key with `baseUrl=https://api.aex.dev`)."},"1989":{"id":"/docs/reference/sdk-1035","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#providers","content":"Symbol-style accessors for the closed provider set. Prefer these over raw\nstrings so an invalid token is a compile error, not a runtime 400 — e.g.\n`Providers.DEEPSEEK`. The same model id can route through different upstream\nproviders (official vs OpenRouter, etc.), so `provider` is a first-class\nsubmission field; name it explicitly with one of these constants rather than\nrelying on the model alone to determine routing."},"1990":{"id":"/docs/reference/sdk-1036","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#providers","content":"Every value mirrors PROVIDERS exactly; a unit test asserts\n`Object.values(Providers)` deep-equals `PROVIDERS` so the two can never\ndrift."},"1991":{"id":"/docs/reference/sdk-1037","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#providers-1","content":"Submission-time provider selector. Aex exposes one customer interface\nfor every provider. All new submissions execute through the managed\nruntime; provider selection only decides which upstream model route\nthe managed provider-proxy uses."},"1992":{"id":"/docs/reference/sdk-1038","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#response_format_kinds","content":"Response-format kinds: free-form `text` (default) or provider-native `json_schema`."},"1993":{"id":"/docs/reference/sdk-1039","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#runtime_kinds","content":"The accepted execution-runtime values (the wire/CLI tokens)."},"1994":{"id":"/docs/reference/sdk-1040","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#runtime_size_presets","content":"The single source of truth: every offered preset, keyed by its wire token.\nTokens intentionally remain stable product presets. The smallest\n(`shared-0.06x-256mb`) tier is for light / IO-bound sessions only."},"1995":{"id":"/docs/reference/sdk-1041","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#runtime_sizes","content":"All preset tokens, ordered as declared. Handy for CLI help + validation."},"1996":{"id":"/docs/reference/sdk-1042","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#runtimekinds","content":"Symbol-style accessors for TS callers: `RuntimeKinds.SPOT_CONTAINER` resolves\nto the wire token `\"spot_container\"`. Re-exported by the SDK as\n`RuntimeKinds`. Prefer these over raw strings so an invalid token is a compile\nerror, not a runtime 400."},"1997":{"id":"/docs/reference/sdk-1043","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#session_statuses","content":"The full closed set of session lifecycle statuses. Run outcomes deliberately\nremain separate so a resumable session never reports `succeeded`/`failed`."},"1998":{"id":"/docs/reference/sdk-1044","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#session_terminal_outcomes","content":"Terminal RUN outcomes. These describe a completed run, not the lifecycle\nstatus of its resumable session thread."},"1999":{"id":"/docs/reference/sdk-1045","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#sizes","content":"Symbol-style accessors for TS callers: the `SHARED_2X_8GB` member resolves to\nthe wire token `\"shared-2x-8gb\"`. Re-exported by the SDK as `Sizes`."},"2000":{"id":"/docs/reference/sdk-1046","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#skill_bundle_limits","content":"Skill-specific authoring constraints layered on the shared asset envelope."},"2001":{"id":"/docs/reference/sdk-1047","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#skill_name_pattern","content":"Human-readable, workspace-scoped name. Lowercase, kebab-friendly,\n1..128 chars. The DB enforces the length bound via\n`skill_bundles_name_len_chk`; this regex tightens the SDK/CLI input\nsurface so callers fail at the boundary rather than in the BFF."},"2002":{"id":"/docs/reference/sdk-1048","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#skill_reserved_names","content":"Names reserved by the skills subsystem and therefore usable as neither a\nskill name nor a custom tool name. `skills` is the injected meta-tool (see\nSKILLS\\_TOOL\\_NAME in `submission.ts`); `skill` is its singular. Both\nthe SDK factories and the BFF `parseSkills` / `parseTools` reject these."},"2003":{"id":"/docs/reference/sdk-1049","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#streamable_shapes","content":"The provider wire-SHAPES that have a real per-token streaming producer. This\nconst is the contracts-side SSoT, pinned EQUAL to the platform's shape SSoT by\na cross-repo parity test so streaming can never be promised for a shape\nnothing feeds."},"2004":{"id":"/docs/reference/sdk-1050","page_id":"/docs/reference/sdk","tags":[],"type":"text","url":"/docs/reference/sdk#supported_models_by_provider","content":"Provider → canonical models that provider can serve. Derived from\nMODEL\\_PROVIDER\\_IDS; every provider currently serves at least one\nmodel, so all ProviderName keys are present."}},"count":2004},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":1140,"2":1672,"3":1141,"4":982,"5":1189,"6":1673,"7":1912,"8":1688,"9":1065,"10":1378,"11":1064,"12":1066,"13":1063,"14":1917,"15":1233,"16":1999,"17":1162,"18":1268,"19":1709,"20":1269,"21":1660,"22":1755,"23":1163,"24":1959,"25":1542,"26":1276,"27":1647,"28":1277,"29":1092,"30":1232,"31":1090,"32":1786,"33":1531,"34":1939,"35":1079,"36":1380,"37":1694,"38":1974,"39":1941,"40":1106,"41":1782,"42":1303,"43":1586,"44":1080,"45":1074,"46":1275,"47":1296,"48":1942,"49":1151,"50":1540,"51":1081,"52":1565,"53":10,"54":12,"55":9,"56":17,"57":13,"58":19,"59":1661,"60":1278,"61":1171,"62":1642,"63":1351,"64":1649,"65":1352,"66":1643,"67":1394,"68":1774,"69":1979,"70":1083,"71":1593,"72":1680,"73":1113,"74":1960,"75":1811,"76":1983,"77":1812,"78":1326,"79":1780,"80":1058,"81":1735,"82":1237,"83":1304,"84":1741,"85":1690,"86":1093,"87":1737,"88":125,"89":22,"90":23,"91":1101,"92":1191,"93":1921,"94":1954,"95":1172,"96":1656,"97":1291,"98":1129,"99":1654,"100":1594,"101":1657,"102":1131,"103":1994,"104":1848,"105":1644,"106":1329,"107":1738,"108":1943,"109":1152,"110":1076,"111":1624,"112":1739,"113":1102,"114":593,"115":1196,"116":594,"117":1567,"118":598,"