{
  "name": "@aexhq/user-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Layer-4 'user tests' — exercise the packed/published aex artifact in a clean install tree, the way a real user or AI agent would on day one. Product SDK/CLI access goes through a child process whose cwd is a fresh `bun install` tempdir; the harness may import shared conformance matchers.",
  "scripts": {
    "pretest:user": "bun run --cwd ../.. --filter @aexhq/conformance build",
    "test:user": "vitest run --config vitest.config.ts test",
    "pretest:user:offline": "bun run --cwd ../.. --filter @aexhq/conformance build",
    "test:user:offline": "vitest run --config vitest.config.ts --maxWorkers 1 --minWorkers 1 test/offline",
    "pretest:user:heavy": "bun run --cwd ../.. --filter @aexhq/conformance build",
    "test:user:heavy": "vitest run --config vitest.heavy.config.ts",
    "pretest:user:providers": "bun run --cwd ../.. --filter @aexhq/conformance build",
    "test:user:providers": "vitest run --config vitest.providers.config.ts",
    "test:user:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@aexhq/conformance": "workspace:*",
    "dotenv": "16.5.0",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
